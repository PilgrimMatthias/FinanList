/* ==========================================
   DARK THEME
   ========================================== */

/* --- Global --- */
QMainWindow {
    background-color: #353535;
}

QWidget {
    color: #ffffff;
    background-color: #353535;
    font-family: "Segoe UI";
    font-size: 14px;
}

QToolTip {
    background-color: #353535;
    color: #ffffff;
    padding: 2px;
    font-size: 10pt;
    border: 1px solid #555555;
}

/* --- Sidebar --- */
QFrame#sidebar {
    background-color: #2b2b2b;
}

/* --- Input Fields --- */
QComboBox,
QLineEdit,
QTextEdit,
QDateEdit {
    background-color: #191919;
    color: #ffffff;
    border: 2px solid #555555;
    border-radius: 10px;
    padding: 6px;
    combobox-popup: 0;
    min-height: 20px;
    max-height: 20px;
}
QTextEdit#Description{
    background-color: #ffffff;
    color: #000000;
    border: 2px solid #bfbfbf;
    border-radius: 10px;
    padding: 6px;
    combobox-popup: 0;
    min-height: 58px;
    max-height: 58px;
}
QComboBox:focus,
QTextEdit:focus,
QLineEdit:focus,
QDateEdit:focus {
    border-color: #2a82da;
}

/* --- ComboBox Dropdown --- */
QComboBox QAbstractItemView {
    background-color: #2b2b2b;
    color: #ffffff;
    border: 2px solid #555555;
    border-radius: 5px;
}

QComboBox QAbstractItemView::item {
    border-radius: 5px;
    padding: 4px;
}

QComboBox QAbstractItemView::item:hover {
    background-color: #555555;
}

QComboBox::drop-down,
QDateEdit::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    background-color: #444444;
    border-top-right-radius: 8px;
    border-bottom-right-radius: 8px;
}

QComboBox::down-arrow,
QDateEdit::down-arrow {
    image: url(images:down_icon.png);
}

/* --- Buttons --- */
QPushButton, QRadioButton {
    background-color: #353535;
    color: #ffffff;
    border: none;
    border-radius: 8px;
    padding: 6px 12px;
}

QPushButton:hover, QRadioButton:hover {
    background-color: #4a4a4a;
}

QPushButton:pressed, QRadioButton:pressed {
    background-color: #2a82da;
}

/* --- Scrollbar Vertical --- */
QScrollBar:vertical {
    border: none;
    background-color: #2b2b2b;
    width: 12px;
    margin: 15px 0px 15px 0px;
}

QScrollBar::handle:vertical {
    background-color: #555555;
    border-radius: 4px;
    min-height: 20px;
}

QScrollBar::handle:vertical:hover {
    background-color: #666666;
}

QScrollBar::handle:vertical:pressed {
    background-color: #777777;
}

QScrollBar::sub-line:vertical {
    border: 1px solid #555555;
    height: 15px;
    border-top-right-radius: 5px;
    subcontrol-position: top;
    subcontrol-origin: margin;
    image: url(images:up_icon.png);
}

QScrollBar::add-line:vertical {
    border: 1px solid #555555;
    height: 15px;
    border-bottom-right-radius: 5px;
    subcontrol-position: bottom;
    subcontrol-origin: margin;
    image: url(images:down_icon.png);
}

QScrollBar::sub-line:vertical:hover,
QScrollBar::add-line:vertical:hover {
    background-color: #4a4a4a;
}

QScrollBar::sub-line:vertical:pressed,
QScrollBar::add-line:vertical:pressed {
    background-color: #555555;
}

QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical {
    background: none;
}

/* --- Checkbox --- */
QCheckBox {
    color: #ffffff;
}

QCheckBox::indicator {
    width: 20px;
    height: 20px;
}

/* --- Table --- */
QTableWidget {
    background-color: #191919;
    color: #ffffff;
    border: 1px solid #555555;
    gridline-color: #444444;
}

QTableWidget::item:selected {
    background-color: #2a82da;
}

QHeaderView::section {
    background-color: #353535;
    color: #ffffff;
    border: 1px solid #555555;
    padding: 4px;
}

/* --- Labels --- */
QLabel {
    color: #ffffff;
}

/* --- Menu --- */
QMenu {
    background-color: #2b2b2b;
    color: #ffffff;
    border: 2px solid #555555;
    border-radius: 10px;
}

QMenu::item:selected {
    background-color: #2a82da;
}


QPushButton#profileCircleButton {
    background-color: #ffffff;
    border: 2px solid #808080;
    border-radius: 60px;
    font-size: 25pt;
    font-weight: bold;
}

QLabel#logoLabel { font-size: 25pt; color: #ffffff; }


QLabel#transactionLabel { font-size: 18pt; font-weight:bold; color: #ffffff;}

QMenu#DropDownMenu {
    border: 2px solid #b5c0c9; 
    border-radius:10px;
    }

/* ==========================================
   QTABLEVIEW STYLING
   Append to dark.qss
   ========================================== */

QTableView {
    background-color: #1e1e2e;
    color: #cdd6f4;
    border: 0.5px solid #45475a;
    border-radius: 8px;
    gridline-color: transparent;
    selection-background-color: transparent;
    selection-color: #cdd6f4;
    outline: 0;
}

QTableView::item {
    padding: 10px 14px;
    border-bottom: 0.5px solid #313244;
    border-radius: 0;
}

QTableView::item:hover {
    background-color: #313244;
}

QTableView::item:selected {
    background-color: #313244;
    color: #cdd6f4;
}

QTableView::item:selected:hover {
    background-color: #3a3a52;
}

QTableView::item:focus {
    outline: 0;
    border: none;
}

/* --- Header --- */
QHeaderView {
    background-color: transparent;
    border: none;
}

QHeaderView::section {
    background-color: #1a1a26;
    color: #a6adc8;
    padding: 10px 14px;
    border: none;
    border-bottom: 0.5px solid #45475a;
    font-weight: 500;
    font-size: 13px;
}

QHeaderView::section:hover {
    background-color: #25253a;
    color: #cdd6f4;
}

QHeaderView::section:first {
    border-top-left-radius: 8px;
}

QHeaderView::section:last {
    border-top-right-radius: 8px;
}

QHeaderView::down-arrow,
QHeaderView::up-arrow {
    subcontrol-position: center right;
    subcontrol-origin: padding;
    right: 8px;
    width: 10px;
    height: 10px;
}


/* --- Corner button (top-left, between headers and scrollbars) --- */
QTableCornerButton::section {
    background-color: #1a1a26;
    border: none;
    border-bottom: 0.5px solid #45475a;
}

/* --- Scrollbars (for table) --- */
QTableView QScrollBar:vertical {
    background-color: transparent;
    width: 10px;
    margin: 4px 2px 4px 0;
    border: none;
}

QTableView QScrollBar::handle:vertical {
    background-color: #45475a;
    border-radius: 4px;
    min-height: 30px;
}

QTableView QScrollBar::handle:vertical:hover {
    background-color: #585b70;
}

QTableView QScrollBar::add-line:vertical,
QTableView QScrollBar::sub-line:vertical {
    height: 0;
    background: none;
    border: none;
}

QTableView QScrollBar:horizontal {
    background-color: transparent;
    height: 10px;
    margin: 0 4px 2px 4px;
    border: none;
}

QTableView QScrollBar::handle:horizontal {
    background-color: #45475a;
    border-radius: 4px;
    min-width: 30px;
}

QTableView QScrollBar::handle:horizontal:hover {
    background-color: #585b70;
}

QTableView QScrollBar::add-line:horizontal,
QTableView QScrollBar::sub-line:horizontal {
    width: 0;
    background: none;
    border: none;
}

QLabel#infoBanner {
    background-color: #1a3a5c;
    color: #89b4fa;
    border: 1px solid #2a5a8c;
    border-radius: 6px;
    padding: 8px 12px;
    font-size: 12px;
}

/*  CALENDAR POPUP STYLING - DARK THEME */

/* --- Calendar container --- */
QCalendarWidget {
    background-color: #1e1e2e;
    border: 1px solid #45475a;
    border-radius: 8px;
}

/* --- Navigation bar (month/year header) --- */
QCalendarWidget QWidget#qt_calendar_navigationbar {
    background-color: #1a1a26;
    border-bottom: 1px solid #45475a;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    padding: 4px 8px;
}

/* --- Month/Year label --- */
QCalendarWidget QToolButton {
    color: #cdd6f4;
    font-size: 13px;
    font-weight: 500;
    background-color: transparent;
    border: none;
    border-radius: 4px;
    padding: 4px 8px;
    margin: 2px;
}

QCalendarWidget QToolButton:hover {
    background-color: #313244;
}

QCalendarWidget QToolButton:pressed {
    background-color: #45475a;
}

/* --- Prev/Next month arrows --- */
QCalendarWidget QToolButton#qt_calendar_prevmonth {
    qproperty-icon: none;
    qproperty-text: "◀";
    font-size: 10px;
    padding: 4px 8px;
}

QCalendarWidget QToolButton#qt_calendar_nextmonth {
    qproperty-icon: none;
    qproperty-text: "▶";
    font-size: 10px;
    padding: 4px 8px;
}

/* --- Month dropdown (QMenu) --- */
QCalendarWidget QMenu {
    background-color: #1e1e2e;
    color: #cdd6f4;
    border: 1px solid #45475a;
    border-radius: 6px;
    padding: 4px;
}

QCalendarWidget QMenu::item {
    padding: 6px 16px;
    border-radius: 4px;
}

QCalendarWidget QMenu::item:selected {
    background-color: #2a82da;
    color: #ffffff;
}

/* --- Year spinbox --- */
QCalendarWidget QSpinBox {
    color: #cdd6f4;
    background-color: #313244;
    border: 1px solid #45475a;
    border-radius: 4px;
    padding: 2px 6px;
    font-size: 13px;
    selection-background-color: #2a82da;
    selection-color: #ffffff;
}

QCalendarWidget QSpinBox::up-button,
QCalendarWidget QSpinBox::down-button {
    subcontrol-origin: border;
    width: 18px;
    background-color: #45475a;
    border: none;
}

QCalendarWidget QSpinBox::up-button {
    border-top-right-radius: 4px;
    subcontrol-position: top right;
}

QCalendarWidget QSpinBox::down-button {
    border-bottom-right-radius: 4px;
    subcontrol-position: bottom right;
}

QCalendarWidget QSpinBox::up-button:hover,
QCalendarWidget QSpinBox::down-button:hover {
    background-color: #585b70;
}

QCalendarWidget QSpinBox::up-arrow {
    image: url(svg:up_arrow.svg);
    width: 8px;
    height: 8px;
}

QCalendarWidget QSpinBox::down-arrow {
    image: url(svg:down_arrow.svg);
    width: 8px;
    height: 8px;
}

/* --- Day header (Mon, Tue, Wed...) --- */
QCalendarWidget QWidget {
    alternate-background-color: transparent;
}

QCalendarWidget QAbstractItemView:enabled {
    background-color: #1e1e2e;
    color: #cdd6f4;
    font-size: 13px;
    selection-background-color: #2a82da;
    selection-color: #ffffff;
    outline: 0;
    border: none;
}

/* --- Day cells --- */
QCalendarWidget QAbstractItemView::item {
    padding: 6px;
    margin: 1px;
    border-radius: 4px;
}

QCalendarWidget QAbstractItemView::item:hover {
    background-color: #313244;
}

QCalendarWidget QAbstractItemView::item:selected {
    background-color: #2a82da;
    color: #ffffff;
    border-radius: 4px;
}

/* --- Today highlight --- */
QCalendarWidget QAbstractItemView::item:focus {
    background-color: #45475a;
    border: 1px solid #2a82da;
    border-radius: 4px;
}

/* --- Days from other months (grayed) --- */
QCalendarWidget QAbstractItemView:disabled {
    color: #585b70;
}

/* --- Weekday header row --- */
QCalendarWidget QWidget#qt_calendar_calendarview {
    background-color: #1e1e2e;
    border-bottom-left-radius: 8px;
    border-bottom-right-radius: 8px;
}


/* === WALLET CARDS === */
QFrame#walletCard {
    border-radius: 12px;
    padding: 5px;
}

/* Force all children transparent */
QFrame#walletCard QWidget {
    background: transparent;
}

/* Active card — same gradient on both themes */
QFrame#walletCard[active="true"] {
    background: qlineargradient(
        x1: 0, y1: 0, x2: 1, y2: 1,
        stop: 0 #1a5fb4,
        stop: 1 #2a82da
    );
    border: none;
}

/* Inactive card */
QFrame#walletCard[active="false"] {
    background-color: #2b2b2b;
    border: 1px solid #45475a;
}

/* --- Text colors --- */
QFrame#walletCard[active="true"] QLabel {
    color: #ffffff;
}

QFrame#walletCard[active="false"] QLabel {
    color: #cdd6f4;
}

QFrame#walletCard[active="true"] QLabel#walletCardMuted,
QFrame#walletCard[active="true"] QLabel#walletCardCurrency {
    color: rgba(255, 255, 255, 0.6);
}

QFrame#walletCard[active="false"] QLabel#walletCardMuted,
QFrame#walletCard[active="false"] QLabel#walletCardCurrency {
    color: #808080;
}

QLabel#walletCardName {
    font-size: 20px;
    font-weight: 600;
}

QLabel#walletCardBalance {
    font-size: 22px;
    font-weight: 500;
}

QFrame#walletCard[active="true"] QLabel#walletActiveBadge {
    background-color: rgba(255, 255, 255, 0.25);
    color: white;
    padding: 2px 10px;
    border-radius: 8px;
    font-size: 11px;
}

/* ==========================================
   DUE TRANSACTIONS DIALOG - DARK THEME
   Append to dark.qss
   ========================================== */

/* --- Dialog header --- */
QLabel#dueDialogTitle {
    font-size: 16px;
    font-weight: 600;
    color: #cdd6f4;
}

QLabel#dueDialogSubtitle {
    font-size: 12px;
    color: #a6adc8;
}

/* --- Group card --- */
QFrame#dueTransactionRow {
    background-color: #1e1e2e;
    border: 2px solid #45475a;
    border-radius: 8px;
}

QFrame#dueTransactionRow QWidget {
    background: transparent;
}

QLabel#dueRowTitle {
    font-size: 14px;
    font-weight: 600;
    color: #cdd6f4;
}

QLabel#dueRowCount {
    font-size: 11px;
    color: #a6adc8;
}

QLabel#dueRowSummary {
    font-size: 11px;
    color: #a6adc8;
}

/* --- Amount, colored via setProperty("operation", ...) --- */
QLabel#dueRowAmount {
    font-size: 13px;
    font-weight: 600;
}

QLabel#dueRowAmount[operation="income"] {
    color: #1d9e75;
}

QLabel#dueRowAmount[operation="expense"] {
    color: #e24b4a;
}

QLabel#dueRowAmount[operation="saving"] {
    color: #6c8cff;
}

QLabel#dueRowAmount[operation="investment"] {
    color: #ba7517;
}

/* --- Occurrence rows --- */
QLabel#occurrenceDate {
    font-size: 13px;
    color: #cdd6f4;
}

QLabel#occurrenceTimeline {
    font-size: 11px;
    color: #a6adc8;
}

QLabel#occurrenceTimeline[overdue="true"] {
    color: #e24b4a;
}

/* --- Skip button (replaces inline bg_color) --- */
QPushButton#dueSkipButton {
    background-color: #4a2a2a;
    color: #f5b3b3;
    border: 1px solid #6b3a3a;
    border-radius: 8px;
    padding: 6px 12px;
}

QPushButton#dueSkipButton:hover {
    background-color: #5c3333;
}

QPushButton#dueSkipButton:pressed {
    background-color: #7a4040;
    color: #ffffff;
}

/* --- Scroll area inside a group card --- */
QFrame#dueTransactionRow QScrollBar:vertical {
    background-color: transparent;
    width: 8px;
    margin: 0;
    border: none;
}

QFrame#dueTransactionRow QScrollBar::handle:vertical {
    background-color: #45475a;
    border-radius: 4px;
    min-height: 24px;
}

QFrame#dueTransactionRow QScrollBar::handle:vertical:hover {
    background-color: #585b70;
}

QFrame#dueTransactionRow QScrollBar::add-line:vertical,
QFrame#dueTransactionRow QScrollBar::sub-line:vertical {
    height: 0;
    background: none;
    border: none;
}


/* ==========================================
   PUSH BUTTON VARIANTS - DARK THEME
   Append to dark.qss

   Use with PushButton(object_name="primaryButton") etc.
   Themed buttons skip their inline stylesheet, so these rules apply.
   ========================================== */

/* --- Primary: solid accent fill --- */
QPushButton#primaryButton {
    background-color: #2a82da;
    color: #ffffff;
    border: 2px solid #2a82da;
    border-radius: 10px;
    font-size: 10pt;
    font-weight: bold;
    padding: 0px;
}

QPushButton#primaryButton:hover {
    background-color: #3d92e8;
    border-color: #3d92e8;
}

QPushButton#primaryButton:pressed {
    background-color: #1a5fb4;
    border-color: #1a5fb4;
    color: #ffffff;
}

QPushButton#primaryButton:disabled {
    background-color: #313244;
    border-color: #313244;
    color: #6c7086;
}

/* --- Secondary: outlined, fills on press (the old alternate_look) --- */
QPushButton#secondaryButton {
    background-color: transparent;
    color: #89b4fa;
    border: 2px solid #2a82da;
    border-radius: 10px;
    font-size: 10pt;
    font-weight: bold;
    padding: 0px;
}

QPushButton#secondaryButton:hover {
    background-color: #253048;
}

QPushButton#secondaryButton:pressed {
    background-color: #1a5fb4;
    border-color: #1a5fb4;
    color: #ffffff;
}

QPushButton#secondaryButton:disabled {
    background-color: transparent;
    border-color: #45475a;
    color: #6c7086;
}

/* --- Neutral: quiet, for low-emphasis actions --- */
QPushButton#neutralButton {
    background-color: #313244;
    color: #cdd6f4;
    border: 1px solid #45475a;
    border-radius: 10px;
    font-size: 10pt;
    font-weight: bold;
    padding: 0px;
}

QPushButton#neutralButton:hover {
    background-color: #3a3a52;
}

QPushButton#neutralButton:pressed {
    background-color: #45475a;
    color: #ffffff;
}

QPushButton#neutralButton:disabled {
    background-color: #26263a;
    border-color: #313244;
    color: #6c7086;
}

/* --- Danger: destructive actions --- */
QPushButton#dangerButton {
    background-color: #4a2a2a;
    color: #f5b3b3;
    border: 1px solid #6b3a3a;
    border-radius: 10px;
    font-size: 10pt;
    font-weight: bold;
    padding: 0px;
}

QPushButton#dangerButton:hover {
    background-color: #5c3333;
}

QPushButton#dangerButton:pressed {
    background-color: #7a4040;
    color: #ffffff;
}

QPushButton#dangerButton:disabled {
    background-color: #26263a;
    border-color: #313244;
    color: #6c7086;
}

/* --- Small size modifier: pair via setProperty("size", "small") --- */
QPushButton[size="small"] {
    font-size: 8pt;
    border-radius: 8px;
}
