/* 
   FINANLIST - DARK THEME

   Palette tokens (for reference - QSS has no variables):

     #181825  base         main window, table header, page background
     #11111b  sidebar      navigation rail
     #1e1e2e  surface      cards, tables, dialogs, calendar
     #313244  surface_alt  inputs, bar tracks, neutral fills
     #3a3a52  surface_hi   hover on surface_alt
     #45475a  border
     #585b70  border_hi    hover / focus borders
     #6c7086  muted        disabled text, empty states
     #a6adc8  text_2       secondary text
     #cdd6f4  text_1       primary text
     #2a82da  accent
     #89b4fa  accent_lt    links, outlined button text
     #1a5fb4  accent_dk    pressed accent

   Elevation rule: raised surfaces are LIGHTER than what they sit on.
   base < surface < surface_alt. Do not put a #1e1e2e card on #353535.

   Section order matches light.qss line for line - diff the two files to
   spot a rule that exists in only one theme.
    */


/* 
   1. GLOBAL
    */

QWidget {
    color: #cdd6f4;
    background-color: transparent;
    font-family: "Segoe UI";
    font-size: 14px;
}

/* Only top-level containers paint a background. Everything else is
   transparent and inherits, which is why there are no
   "SomeCard QWidget { background: transparent; }" rules anywhere below. */
QMainWindow {
    background-color: #181825;
}

QDialog {
    background-color: #1e1e2e;
}

QLabel {
    color: #cdd6f4;
}

QToolTip {
    background-color: #313244;
    color: #cdd6f4;
    border: 1px solid #45475a;
    border-radius: 4px;
    padding: 4px 6px;
    font-size: 10pt;
}

/* --- Sidebar ------------------------------------------------------------ */
QFrame#sidebar {
    background-color: #11111b;
}


/* 
   2. INPUT FIELDS
    */

/* Height clamp applies only to single-line controls. QTextEdit is excluded
   on purpose - it used to inherit max-height: 20px here, which silently
   crushed ResizableTextEdit and anything else subclassing QTextEdit. */
QComboBox,
QLineEdit,
QDateEdit {
    background-color: #313244;
    color: #cdd6f4;
    border: 2px solid #45475a;
    border-radius: 10px;
    padding: 6px;
    min-height: 20px;
    max-height: 20px;
}

QComboBox {
    combobox-popup: 0;
}

QTextEdit {
    background-color: #313244;
    color: #cdd6f4;
    border: 2px solid #45475a;
    border-radius: 10px;
    padding: 6px;
}

QTextEdit#Description {
    min-height: 58px;
    max-height: 58px;
}

QComboBox:focus,
QLineEdit:focus,
QDateEdit:focus,
QTextEdit:focus {
    border-color: #2a82da;
}

QComboBox:disabled,
QLineEdit:disabled,
QDateEdit:disabled,
QTextEdit:disabled {
    background-color: #26263a;
    color: #6c7086;
    border-color: #313244;
}

/* --- ComboBox / DateEdit drop-down ------------------------------------- */
QComboBox::drop-down,
QDateEdit::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    background-color: #45475a;
    border-top-right-radius: 8px;
    border-bottom-right-radius: 8px;
}

QComboBox::down-arrow,
QDateEdit::down-arrow {
    image: url(svg:down_arrow_dark.svg);
    width: 10px;
    height: 10px;
}

QComboBox QAbstractItemView {
    background-color: #1e1e2e;
    color: #cdd6f4;
    border: 2px solid #45475a;
    border-radius: 5px;
    selection-background-color: #2a82da;
    selection-color: #ffffff;
    outline: 0;
}

QComboBox QAbstractItemView::item {
    border-radius: 5px;
    padding: 4px;
}

QComboBox QAbstractItemView::item:hover {
    background-color: #313244;
}


/* 
   3. CHECKBOX

   Single-colon pseudo-states. The old ::checked / ::hover were sub-control
   syntax and never matched, so the tick never appeared.

   check_icon.svg has no baked colour variant, so the checked indicator is
   filled light here and the existing dark tick reads on it. If you add
   {{ICON_COLOR}} to that template and re-bake, switch to an accent fill
   plus check_icon_dark.svg.
    */

QCheckBox {
    color: #cdd6f4;
    spacing: 8px;
}

QCheckBox::indicator {
    width: 15px;
    height: 15px;
    border-radius: 4px;
    border: 2px solid #585b70;
    background-color: #313244;
}

QCheckBox::indicator:hover {
    border-color: #2a82da;
}

QCheckBox::indicator:checked {
    background-color: #cdd6f4;
    border-color: #2a82da;
    image: url(svg:check_icon.svg);
}

QCheckBox::indicator:disabled {
    border-color: #313244;
    background-color: #26263a;
}

QCheckBox:disabled {
    color: #6c7086;
}


/* 
   4. MENUS
    */

QMenu {
    background-color: #1e1e2e;
    color: #cdd6f4;
    border: 2px solid #45475a;
    border-radius: 10px;
    padding: 4px;
}

QMenu::item {
    padding: 6px 16px;
    border-radius: 6px;
}

QMenu::item:selected {
    background-color: #2a82da;
    color: #ffffff;
}

QMenu::separator {
    height: 1px;
    background-color: #45475a;
    margin: 4px 8px;
}

QMenu#DropDownMenu {
    border: 2px solid #585b70;
    border-radius: 10px;
}


/* 
   5. SCROLLBARS (application-wide)
    */

QScrollBar:vertical {
    border: none;
    background-color: #11111b;
    width: 12px;
    margin: 15px 0px 15px 0px;
}

QScrollBar::handle:vertical {
    background-color: #45475a;
    border-radius: 4px;
    min-height: 20px;
}

QScrollBar::handle:vertical:hover {
    background-color: #585b70;
}

QScrollBar::handle:vertical:pressed {
    background-color: #6c7086;
}

QScrollBar::sub-line:vertical {
    border: 1px solid #45475a;
    height: 15px;
    border-top-right-radius: 5px;
    subcontrol-position: top;
    subcontrol-origin: margin;
    image: url(svg:up_arrow_dark.svg);
}

QScrollBar::add-line:vertical {
    border: 1px solid #45475a;
    height: 15px;
    border-bottom-right-radius: 5px;
    subcontrol-position: bottom;
    subcontrol-origin: margin;
    image: url(svg:down_arrow_dark.svg);
}

QScrollBar::sub-line:vertical:hover,
QScrollBar::add-line:vertical:hover {
    background-color: #313244;
}

QScrollBar::sub-line:vertical:pressed,
QScrollBar::add-line:vertical:pressed {
    background-color: #45475a;
}

QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical {
    background: none;
}

/* --- Slim variant: scroll areas nested inside cards and dialogs --------
   One rule set instead of the near-identical copies that used to live in
   the due-dialog and settings sections. */
QFrame#dueTransactionRow QScrollBar:vertical,
QScrollArea#settingsScrollArea QScrollBar:vertical {
    background-color: transparent;
    width: 8px;
    margin: 0;
    border: none;
}

QFrame#dueTransactionRow QScrollBar::handle:vertical,
QScrollArea#settingsScrollArea QScrollBar::handle:vertical {
    background-color: #45475a;
    border-radius: 4px;
    min-height: 24px;
}

QFrame#dueTransactionRow QScrollBar::handle:vertical:hover,
QScrollArea#settingsScrollArea QScrollBar::handle:vertical:hover {
    background-color: #585b70;
}

QFrame#dueTransactionRow QScrollBar::add-line:vertical,
QFrame#dueTransactionRow QScrollBar::sub-line:vertical,
QScrollArea#settingsScrollArea QScrollBar::add-line:vertical,
QScrollArea#settingsScrollArea QScrollBar::sub-line:vertical {
    height: 0;
    background: none;
    border: none;
    image: none;
}

QFrame#dueTransactionRow QScrollBar::add-page:vertical,
QFrame#dueTransactionRow QScrollBar::sub-page:vertical,
QScrollArea#settingsScrollArea QScrollBar::add-page:vertical,
QScrollArea#settingsScrollArea QScrollBar::sub-page:vertical {
    background: none;
}


/* 
   6. QTABLEVIEW
    */

QTableView {
    background-color: #1e1e2e;
    color: #cdd6f4;
    border: 1px solid #45475a;
    border-radius: 8px;
    gridline-color: transparent;
    selection-background-color: transparent;
    selection-color: #cdd6f4;
    outline: 0;
}

QTableView::item {
    padding: 10px 14px;
    border-bottom: 1px solid #313244;
    border-radius: 0;
}

QTableView::item:hover {
    background-color: #313244;
}

QTableView::item:selected {
    background-color: #313244;
    color: #cdd6f4;
}

QTableView::item:selected:hover {
    background-color: #3a3a52;
}

QTableView::item:focus {
    outline: 0;
    border: none;
}

/* --- Header ------------------------------------------------------------ */
QHeaderView {
    background-color: transparent;
    border: none;
}

QHeaderView::section {
    background-color: #181825;
    color: #a6adc8;
    padding: 10px 14px;
    border: none;
    border-bottom: 1px solid #45475a;
    font-weight: 500;
    font-size: 13px;
}

QHeaderView::section:hover {
    background-color: #25253a;
    color: #cdd6f4;
}

QHeaderView::section:first {
    border-top-left-radius: 8px;
}

QHeaderView::section:last {
    border-top-right-radius: 8px;
}

/* The sort indicator. These blocks previously set geometry but no image,
   so clicking a header produced no visible arrow at all. */
QHeaderView::down-arrow {
    image: url(svg:down_arrow_dark.svg);
    subcontrol-origin: padding;
    subcontrol-position: center right;
    right: 8px;
    width: 10px;
    height: 10px;
}

QHeaderView::up-arrow {
    image: url(svg:up_arrow_dark.svg);
    subcontrol-origin: padding;
    subcontrol-position: center right;
    right: 8px;
    width: 10px;
    height: 10px;
}

QTableCornerButton::section {
    background-color: #181825;
    border: none;
    border-bottom: 1px solid #45475a;
}

/* --- Table scrollbars -------------------------------------------------- */
QTableView QScrollBar:vertical {
    background-color: transparent;
    width: 10px;
    margin: 4px 2px 4px 0;
    border: none;
}

QTableView QScrollBar::handle:vertical {
    background-color: #45475a;
    border-radius: 4px;
    min-height: 30px;
}

QTableView QScrollBar::handle:vertical:hover {
    background-color: #585b70;
}

QTableView QScrollBar::add-line:vertical,
QTableView QScrollBar::sub-line:vertical {
    height: 0;
    background: none;
    border: none;
    image: none;
}

QTableView QScrollBar:horizontal {
    background-color: transparent;
    height: 10px;
    margin: 0 4px 2px 4px;
    border: none;
}

QTableView QScrollBar::handle:horizontal {
    background-color: #45475a;
    border-radius: 4px;
    min-width: 30px;
}

QTableView QScrollBar::handle:horizontal:hover {
    background-color: #585b70;
}

QTableView QScrollBar::add-line:horizontal,
QTableView QScrollBar::sub-line:horizontal {
    width: 0;
    background: none;
    border: none;
    image: none;
}


/* 
   7. CALENDAR POPUP
    */

QCalendarWidget {
    background-color: #1e1e2e;
    border: 1px solid #45475a;
    border-radius: 8px;
}

QCalendarWidget QWidget {
    alternate-background-color: transparent;
}

QCalendarWidget QWidget#qt_calendar_navigationbar {
    background-color: #181825;
    border-bottom: 1px solid #45475a;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    padding: 4px 8px;
}

QCalendarWidget QToolButton {
    color: #cdd6f4;
    font-size: 13px;
    font-weight: 500;
    background-color: transparent;
    border: none;
    border-radius: 4px;
    padding: 4px 8px;
    margin: 2px;
}

QCalendarWidget QToolButton:hover {
    background-color: #313244;
}

QCalendarWidget QToolButton:pressed {
    background-color: #45475a;
}

QCalendarWidget QToolButton#qt_calendar_prevmonth {
    qproperty-icon: none;
    qproperty-text: "\25C0";
    font-size: 10px;
    padding: 4px 8px;
}

QCalendarWidget QToolButton#qt_calendar_nextmonth {
    qproperty-icon: none;
    qproperty-text: "\25B6";
    font-size: 10px;
    padding: 4px 8px;
}

QCalendarWidget QMenu {
    background-color: #1e1e2e;
    color: #cdd6f4;
    border: 1px solid #45475a;
    border-radius: 6px;
    padding: 4px;
}

QCalendarWidget QMenu::item {
    padding: 6px 16px;
    border-radius: 4px;
}

QCalendarWidget QMenu::item:selected {
    background-color: #2a82da;
    color: #ffffff;
}

/* --- Year spinbox ------------------------------------------------------ */
QCalendarWidget QSpinBox {
    color: #cdd6f4;
    background-color: #313244;
    border: 1px solid #45475a;
    border-radius: 4px;
    padding: 2px 6px;
    font-size: 13px;
    selection-background-color: #2a82da;
    selection-color: #ffffff;
}

QCalendarWidget QSpinBox::up-button,
QCalendarWidget QSpinBox::down-button {
    subcontrol-origin: border;
    width: 18px;
    background-color: #45475a;
    border: none;
}

QCalendarWidget QSpinBox::up-button {
    border-top-right-radius: 4px;
    subcontrol-position: top right;
}

QCalendarWidget QSpinBox::down-button {
    border-bottom-right-radius: 4px;
    subcontrol-position: bottom right;
}

QCalendarWidget QSpinBox::up-button:hover,
QCalendarWidget QSpinBox::down-button:hover {
    background-color: #585b70;
}

QCalendarWidget QSpinBox::up-arrow {
    image: url(svg:up_arrow_dark.svg);
    width: 8px;
    height: 8px;
}

QCalendarWidget QSpinBox::down-arrow {
    image: url(svg:down_arrow_dark.svg);
    width: 8px;
    height: 8px;
}

/* --- Day grid ---------------------------------------------------------- */
QCalendarWidget QAbstractItemView:enabled {
    background-color: #1e1e2e;
    color: #cdd6f4;
    font-size: 13px;
    selection-background-color: #2a82da;
    selection-color: #ffffff;
    outline: 0;
    border: none;
}

QCalendarWidget QAbstractItemView:disabled {
    color: #585b70;
}

QCalendarWidget QAbstractItemView::item {
    padding: 6px;
    margin: 1px;
    border-radius: 4px;
}

QCalendarWidget QAbstractItemView::item:hover {
    background-color: #313244;
}

QCalendarWidget QAbstractItemView::item:selected {
    background-color: #2a82da;
    color: #ffffff;
    border-radius: 4px;
}

QCalendarWidget QAbstractItemView::item:focus {
    background-color: #45475a;
    border: 1px solid #2a82da;
    border-radius: 4px;
}

QCalendarWidget QWidget#qt_calendar_calendarview {
    background-color: #1e1e2e;
    border-bottom-left-radius: 8px;
    border-bottom-right-radius: 8px;
}


/* 
   8. BUTTONS - default look for buttons with no object name
    */

QPushButton,
QRadioButton {
    background-color: #313244;
    color: #cdd6f4;
    border: none;
    border-radius: 8px;
    padding: 6px 12px;
}

QPushButton:hover,
QRadioButton:hover {
    background-color: #3a3a52;
}

QPushButton:pressed,
QRadioButton:pressed {
    background-color: #2a82da;
    color: #ffffff;
}

QPushButton:disabled {
    background-color: #26263a;
    color: #6c7086;
}


/* 
   9. BUTTON VARIANTS - PushButton(object_name="primaryButton") etc.
    */

/* --- Primary ----------------------------------------------------------- */
QPushButton#primaryButton {
    background-color: #2a82da;
    color: #ffffff;
    border: 2px solid #2a82da;
    border-radius: 10px;
    font-size: 10pt;
    font-weight: bold;
    padding: 0px;
}

QPushButton#primaryButton:hover {
    background-color: #3d92e8;
    border-color: #3d92e8;
}

QPushButton#primaryButton:pressed {
    background-color: #1a5fb4;
    border-color: #1a5fb4;
    color: #ffffff;
}

QPushButton#primaryButton:disabled {
    background-color: #313244;
    border-color: #313244;
    color: #6c7086;
}

/* --- Secondary (outlined) ---------------------------------------------- */
QPushButton#secondaryButton {
    background-color: transparent;
    color: #89b4fa;
    border: 2px solid #2a82da;
    border-radius: 10px;
    font-size: 10pt;
    font-weight: bold;
    padding: 0px;
}

QPushButton#secondaryButton:hover {
    background-color: #253048;
}

QPushButton#secondaryButton:pressed {
    background-color: #1a5fb4;
    border-color: #1a5fb4;
    color: #ffffff;
}

QPushButton#secondaryButton:disabled {
    background-color: transparent;
    border-color: #45475a;
    color: #6c7086;
}

/* --- Neutral ----------------------------------------------------------- */
QPushButton#neutralButton {
    background-color: #313244;
    color: #cdd6f4;
    border: 1px solid #45475a;
    border-radius: 10px;
    font-size: 10pt;
    font-weight: bold;
    padding: 0px;
}

QPushButton#neutralButton:hover {
    background-color: #3a3a52;
}

QPushButton#neutralButton:pressed {
    background-color: #45475a;
    color: #ffffff;
}

QPushButton#neutralButton:disabled {
    background-color: #26263a;
    border-color: #313244;
    color: #6c7086;
}

/* --- Danger ------------------------------------------------------------ */
QPushButton#dangerButton,
QPushButton#dueSkipButton {
    background-color: #4a2a2a;
    color: #f5b3b3;
    border: 1px solid #6b3a3a;
    border-radius: 10px;
    font-size: 10pt;
    font-weight: bold;
    padding: 0px;
}

QPushButton#dangerButton:hover,
QPushButton#dueSkipButton:hover {
    background-color: #5c3333;
    border-color: #7a4040;
}

QPushButton#dangerButton:pressed,
QPushButton#dueSkipButton:pressed {
    background-color: #7a4040;
    color: #ffffff;
    border-color: #8b4a4a;
}

QPushButton#dangerButton:disabled,
QPushButton#dueSkipButton:disabled {
    background-color: #26263a;
    border-color: #313244;
    color: #6c7086;
}

/* --- Link ("View all") ------------------------------------------------- */
QPushButton#viewAllButton {
    background: transparent;
    color: #89b4fa;
    border: none;
    font-size: 11px;
    font-weight: 500;
    text-align: right;
    padding: 0px;
}

QPushButton#viewAllButton:hover {
    color: #a6c8ff;
    text-decoration: underline;
}

QPushButton#viewAllButton:pressed {
    background: transparent;
    color: #6c8cff;
}

/* --- Profile circle ---------------------------------------------------- */
QPushButton#profileCircleButton {
    background-color: #1e1e2e;
    color: #cdd6f4;
    border: 2px solid #585b70;
    border-radius: 60px;
    font-size: 25pt;
    font-weight: bold;
}

QPushButton#profileCircleButton:hover {
    background-color: #313244;
    border-color: #6c7086;
}

QPushButton#profileCircleButton:pressed {
    background-color: #45475a;
}

/* --- Small size modifier ----------------------------------------------
   The bare QPushButton[size="small"] rule loses to every #objectName rule
   above, so each variant needs its own scoped copy or font_size does
   nothing on a themed button. */
QPushButton[size="small"] {
    font-size: 8pt;
    border-radius: 8px;
}

QPushButton#primaryButton[size="small"],
QPushButton#secondaryButton[size="small"],
QPushButton#neutralButton[size="small"],
QPushButton#dangerButton[size="small"],
QPushButton#dueSkipButton[size="small"] {
    font-size: 8pt;
    border-radius: 8px;
}


/* 
   10. SEPARATORS
    */

QFrame#hLine {
    border: none;
    border-top: 1px solid #313244;
    max-height: 1px;
    min-height: 1px;
}

QFrame#vLine {
    border: none;
    border-left: 1px solid #313244;
    max-width: 1px;
    min-width: 1px;
}

QFrame#hLine[emphasis="strong"] {
    border-top: 1px solid #45475a;
}

QFrame#vLine[emphasis="strong"] {
    border-left: 1px solid #45475a;
}


/* 
   11. SHARED LABELS
    */

QLabel#inputLabel {
    font-size: 13px;
    color: #cdd6f4;
}

QLabel#inputSubLabel {
    font-size: 11px;
    color: #a6adc8;
}

QLabel#logoLabel {
    font-size: 25pt;
    color: #cdd6f4;
}

QLabel#transactionLabel {
    font-size: 18pt;
    font-weight: bold;
    color: #cdd6f4;
}

QLabel#infoBanner {
    background-color: #1a3a5c;
    color: #89b4fa;
    border: 1px solid #2a5a8c;
    border-radius: 6px;
    padding: 8px 12px;
    font-size: 12px;
}

QLabel#not_tr_label {
    font-size: 11pt;
    font-weight: bold;
    color: #a6adc8;
}

QLabel#main_category_label {
    font-size: 10.5pt;
    font-weight: bold;
    color: #cdd6f4;
}

QLabel#category_label {
    font-size: 10pt;
    color: #a6adc8;
}


/* 
   12. OPERATION TYPE PILLS (QLabel form)

   The QTableView uses TypePillDelegate instead. These are for the places
   that still show an operation type as a plain label. They had no dark
   equivalent at all, so they rendered as bare white text here.
    */

QLabel#Income,
QLabel#Expense,
QLabel#Saving,
QLabel#Investment {
    font-size: 10pt;
    border-radius: 8px;
    padding: 2px 8px;
}

QLabel#Income {
    color: #8fe0c0;
    background-color: #1e4034;
    border: 1px solid #1e4034;
}

QLabel#Expense {
    color: #f5b3b3;
    background-color: #4a2a2a;
    border: 1px solid #4a2a2a;
}

QLabel#Saving {
    color: #b4b0f5;
    background-color: #2b2a52;
    border: 1px solid #2b2a52;
}

QLabel#Investment {
    color: #e8c88a;
    background-color: #4a3a1c;
    border: 1px solid #4a3a1c;
}


/* 
   13. WALLET CARDS
    */

QFrame#walletCard {
    border-radius: 12px;
    padding: 5px;
}

/* Active card - same gradient in both themes */
QFrame#walletCard[active="true"] {
    background: qlineargradient(
        x1: 0, y1: 0, x2: 1, y2: 1,
        stop: 0 #1a5fb4,
        stop: 1 #2a82da
    );
    border: none;
}

QFrame#walletCard[active="false"] {
    background-color: #1e1e2e;
    border: 1px solid #45475a;
}

QFrame#walletCard[active="true"] QLabel {
    color: #ffffff;
}

QFrame#walletCard[active="false"] QLabel {
    color: #cdd6f4;
}

QFrame#walletCard[active="true"] QLabel#walletCardMuted,
QFrame#walletCard[active="true"] QLabel#walletCardCurrency {
    color: rgba(255, 255, 255, 0.6);
}

QFrame#walletCard[active="false"] QLabel#walletCardMuted,
QFrame#walletCard[active="false"] QLabel#walletCardCurrency {
    color: #a6adc8;
}

QLabel#walletCardName {
    font-size: 20px;
    font-weight: 600;
}

QLabel#walletCardBalance {
    font-size: 22px;
    font-weight: 500;
}

QFrame#walletCard[active="true"] QLabel#walletActiveBadge {
    background-color: rgba(255, 255, 255, 0.25);
    color: #ffffff;
    padding: 2px 10px;
    border-radius: 8px;
    font-size: 11px;
}

/* --- Wallet card buttons ----------------------------------------------- */
QPushButton#walletCardBtnPrimary {
    background-color: #0c447c;
    color: #b5d4f4;
    border: 1px solid #185fa5;
    border-radius: 6px;
    font-size: 11px;
    font-weight: bold;
    padding: 0px;
}

QPushButton#walletCardBtnPrimary:hover {
    background-color: #185fa5;
    color: #d8e8fa;
    border-color: #378add;
}

QPushButton#walletCardBtnPrimary:pressed {
    background-color: #378add;
    color: #ffffff;
    border-color: #85b7eb;
}

QPushButton#walletCardBtnNeutral {
    background-color: #313244;
    color: #cdd6f4;
    border: 1px solid #45475a;
    border-radius: 6px;
    font-size: 11px;
    font-weight: bold;
    padding: 0px;
}

QPushButton#walletCardBtnNeutral:hover {
    background-color: #3a3a52;
    border-color: #585b70;
}

QPushButton#walletCardBtnNeutral:pressed {
    background-color: #45475a;
    color: #ffffff;
    border-color: #6c7086;
}

QPushButton#walletCardBtnDanger {
    background-color: #4a2a2a;
    color: #f5b3b3;
    border: 1px solid #6b3a3a;
    border-radius: 6px;
    font-size: 11px;
    font-weight: bold;
    padding: 0px;
}

QPushButton#walletCardBtnDanger:hover {
    background-color: #5c3333;
    border-color: #7a4040;
}

QPushButton#walletCardBtnDanger:pressed {
    background-color: #7a4040;
    color: #ffffff;
    border-color: #8b4a4a;
}

/* Buttons on the active card's gradient - identical in both themes */
QPushButton#walletCardBtnOnGradient {
    background-color: rgba(255, 255, 255, 0.2);
    color: #ffffff;
    border: 1px solid rgba(255, 255, 255, 0.35);
    border-radius: 6px;
    font-size: 11px;
    font-weight: bold;
    padding: 0px;
}

QPushButton#walletCardBtnOnGradient:hover {
    background-color: rgba(255, 255, 255, 0.35);
    border-color: rgba(255, 255, 255, 0.45);
}

QPushButton#walletCardBtnOnGradient:pressed {
    background-color: rgba(255, 255, 255, 0.5);
    border-color: rgba(255, 255, 255, 0.55);
}

QPushButton#addWalletBtn {
    background-color: transparent;
    color: #6c7086;
    border: 2px solid #45475a;
    border-radius: 12px;
    font-size: 14px;
    font-weight: bold;
    padding: 14px;
}

QPushButton#addWalletBtn:hover {
    background-color: #262636;
    color: #a6adc8;
    border-color: #585b70;
}

QPushButton#addWalletBtn:pressed {
    background-color: #313244;
    color: #cdd6f4;
    border-color: #6c7086;
}

QPushButton#walletCardBtnPrimary:disabled,
QPushButton#walletCardBtnNeutral:disabled,
QPushButton#walletCardBtnDanger:disabled,
QPushButton#addWalletBtn:disabled {
    background-color: #26263a;
    color: #585b70;
    border-color: #313244;
}

QPushButton#walletCardBtnOnGradient:disabled {
    background-color: rgba(255, 255, 255, 0.08);
    color: rgba(255, 255, 255, 0.4);
    border-color: rgba(255, 255, 255, 0.15);
}


/* 
   14. DASHBOARD
    */

QFrame#balanceTile,
QFrame#monthTile,
QFrame#dueTile,
QFrame#categoryBars,
QFrame#recentOperationsCard,
QFrame#upcomingCard {
    background-color: #1e1e2e;
    border: 1px solid #45475a;
    border-radius: 10px;
}

QFrame#dueTile[alert="true"] {
    border: 1px solid #6b3a3a;
}

/* --- Greeting row ------------------------------------------------------ */
QLabel#dashboardNameLabel {
    font-size: 18px;
    font-weight: 600;
    color: #cdd6f4;
}

QLabel#dashboardDate {
    font-size: 12px;
    color: #a6adc8;
}

/* --- Shared tile captions ---------------------------------------------- */
QLabel#balanceTileLabel,
QLabel#monthTileTopLabel,
QLabel#dueTileLabel {
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 1px;
    color: #a6adc8;
}

/* --- Balance tile ------------------------------------------------------ */
QLabel#balanceTileAmount {
    font-size: 24px;
    font-weight: 600;
    color: #cdd6f4;
}

QLabel#balanceTileWallet {
    font-size: 11px;
    color: #a6adc8;
}

/* --- Month tile -------------------------------------------------------- */
QLabel#monthTileMiddleLabel {
    font-size: 13px;
    color: #a6adc8;
}

QLabel#monthTileBottomLabel {
    font-size: 13px;
    font-weight: 600;
    color: #cdd6f4;
}

QLabel#monthTileIncome {
    font-size: 13px;
    font-weight: 500;
    color: #1d9e75;
}

QLabel#monthTileExpense {
    font-size: 13px;
    font-weight: 500;
    color: #e24b4a;
}

QLabel#monthTileNet {
    font-size: 13px;
    font-weight: 600;
}

QLabel#monthTileNet[positive="true"] {
    color: #1d9e75;
}

QLabel#monthTileNet[positive="false"] {
    color: #e24b4a;
}

/* --- Due tile ---------------------------------------------------------- */
QLabel#dueTileDueNum {
    font-size: 20px;
    font-weight: 600;
    color: #cdd6f4;
}

QFrame#dueTile[alert="true"] QLabel#dueTileDueNum {
    color: #e24b4a;
}

QLabel#dueTileBottom {
    font-size: 11px;
    color: #a6adc8;
}

/* --- Category bars ----------------------------------------------------- */
QLabel#categoryBarsTitle {
    font-size: 14px;
    font-weight: 600;
    color: #cdd6f4;
}

QLabel#categoryBarsMonth,
QLabel#categoryBarsTotal {
    font-size: 11px;
    color: #a6adc8;
}

QLabel#categoryBarName {
    font-size: 13px;
    color: #a6adc8;
}

QLabel#categoryBarTotal {
    font-size: 13px;
    color: #cdd6f4;
}

QLabel#categoryBarsEmptyState {
    font-size: 12px;
    color: #6c7086;
}

/* Fill colour stays inline - it is per-category data, not theme */
QFrame#barTrack {
    background-color: #313244;
    border: none;
    border-radius: 4px;
}

QWidget#barSpacer {
    background: transparent;
}

/* --- List cards -------------------------------------------------------- */
QLabel#recOperTitle,
QLabel#upcCardTitle {
    font-size: 14px;
    font-weight: 600;
    color: #cdd6f4;
}

QLabel#recOperRowTitle,
QLabel#upcCardRowTitle {
    font-size: 13px;
    color: #cdd6f4;
}

QLabel#recOperRowDate,
QLabel#upcCardRowDate,
QLabel#recOperRowMerchant {
    font-size: 12px;
    color: #a6adc8;
}

QLabel#recOperRowAmount,
QLabel#upcCardRowAmount {
    font-size: 13px;
    font-weight: 500;
}

QLabel#recOperRowAmount[positive="true"],
QLabel#upcCardRowAmount[positive="true"] {
    color: #1d9e75;
}

QLabel#recOperRowAmount[positive="false"],
QLabel#upcCardRowAmount[positive="false"] {
    color: #e24b4a;
}

QLabel#recOperEmptyState,
QLabel#upcCardEmptyState {
    font-size: 12px;
    color: #6c7086;
}


/* 
   15. DUE TRANSACTIONS DIALOG
    */

QLabel#dueDialogTitle {
    font-size: 16px;
    font-weight: 600;
    color: #cdd6f4;
}

QLabel#dueDialogSubtitle {
    font-size: 12px;
    color: #a6adc8;
}

QFrame#dueTransactionRow {
    background-color: #1e1e2e;
    border: 2px solid #45475a;
    border-radius: 8px;
}

QLabel#dueRowTitle {
    font-size: 14px;
    font-weight: 600;
    color: #cdd6f4;
}

/* Interval chip - this existed only in light.qss before */
QLabel#dueRowInterval {
    font-size: 12px;
    color: #a6adc8;
    background-color: #313244;
    border: 1px solid #45475a;
    border-radius: 10px;
    padding: 0px 10px;
}

QLabel#dueRowCount,
QLabel#dueRowSummary {
    font-size: 11px;
    color: #a6adc8;
}

QLabel#dueRowAmount {
    font-size: 13px;
    font-weight: 600;
}

QLabel#dueRowAmount[operation="income"] {
    color: #1d9e75;
}

QLabel#dueRowAmount[operation="expense"] {
    color: #e24b4a;
}

QLabel#dueRowAmount[operation="saving"] {
    color: #6c8cff;
}

QLabel#dueRowAmount[operation="investment"] {
    color: #ba7517;
}

QLabel#occurrenceDate {
    font-size: 13px;
    color: #cdd6f4;
}

QLabel#occurrenceTimeline {
    font-size: 11px;
    color: #a6adc8;
}

QLabel#occurrenceTimeline[overdue="true"] {
    color: #e24b4a;
}


/* 
   16. PROFILE DIALOG
    */

QLabel#profileDialogTitle {
    font-size: 17px;
    font-weight: 600;
    color: #cdd6f4;
}

QLabel#profileDialogSubtitle {
    font-size: 12px;
    color: #a6adc8;
}

QLabel#profileDialogInitial {
    background-color: #1e1e2e;
    color: #cdd6f4;
    border: 2px solid #585b70;
    border-radius: 40px;
    font-size: 25pt;
    font-weight: bold;
}

QLabel#profileDialogNameLabel {
    font-size: 15px;
    font-weight: 600;
    color: #cdd6f4;
}

QLabel#profileDialogMemberLabel {
    font-size: 11px;
    color: #a6adc8;
}

QWidget#profileSummary {
    background-color: #181825;
    border: 1px solid #45475a;
    border-radius: 10px;
}

QLabel#leftMonthTitle,
QLabel#savingsRateLabel {
    font-size: 11px;
    color: #a6adc8;
}

QLabel#leftMonthAmount,
QLabel#savingsRateAmount {
    font-size: 19px;
    font-weight: 600;
    color: #cdd6f4;
}

QLabel#leftMonthAmount[positive="true"],
QLabel#savingsRateAmount[positive="true"] {
    color: #1d9e75;
}

QLabel#leftMonthAmount[positive="false"],
QLabel#savingsRateAmount[positive="false"] {
    color: #e24b4a;
}

/* Legacy - Settings moved to #settingsApplyNote. Drop if unreferenced. */
QLabel#profileUnsaved {
    font-size: 11px;
    color: #d4a259;
}


/* 
   17. SETTINGS DIALOG
    */

QDialog#settingsDialog {
    background-color: #1e1e2e;
}

QLabel#settingsDialogTitle {
    font-size: 17px;
    font-weight: 600;
    color: #cdd6f4;
}

QLabel#settingsDialogSubtitle {
    font-size: 12px;
    color: #a6adc8;
}

QLabel#settingsSectionLabel {
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 1px;
    color: #a6adc8;
    margin-top: 10px;
}

QLabel#settingsApplyNote {
    font-size: 11px;
    color: #a6adc8;
}

QScrollArea#settingsScrollArea {
    background: transparent;
    border: none;
}


/* 
   18. LEGACY - pre-refactor widgets

   Scoped under QTableWidget so the old header rule no longer competes with
   the QTableView one in section 6. Delete this whole block once nothing
   references QTableWidget or ResizableTextEdit.
    */

QTableWidget {
    background-color: #1e1e2e;
    color: #cdd6f4;
    border: 1px solid #45475a;
    gridline-color: #313244;
}

QTableWidget::item:selected {
    background-color: #2a82da;
    color: #ffffff;
}

QTableWidget QHeaderView::section {
    background-color: #181825;
    color: #cdd6f4;
    border: 1px solid #45475a;
    padding: 4px;
}

ResizableTextEdit {
    background-color: #313244;
    color: #cdd6f4;
    border: 2px solid #45475a;
    border-radius: 10px;
    padding: 6px;
}

/* Segmented control  */
QFrame#segmentedTrack {
    background-color: #313244;          /* light: #e9ecf0 */
    border: none;
    border-radius: 7px;
}

QPushButton#segmentButton {
    background-color: transparent;
    color: #a6adc8;                     /* light: #4a525c */
    border: none;
    border-radius: 5px;
    padding: 4px 12px;
    font-size: 12px;
    font-weight: 500;
}

QPushButton#segmentButton:hover {
    color: #cdd6f4;                     /* light: #1e1e1e */
}

QPushButton#segmentButton:checked {
    background-color: #45475a;          /* light: #ffffff */
    color: #cdd6f4;                     /* light: #1e1e1e */
    font-weight: 600;
}

QPushButton#segmentButton:pressed {
    background-color: #585b70;          /* light: #d9d9d9 */
}

QPushButton#segmentButton:disabled {
    color: #6c7086;                     /* light: #b3b3b3 */
}

/* ANALYSIS - FORECAST */

/* Cards */
QFrame#analysisCard {
    background-color: #1f2329;
    border: 1px solid #2e343c;
    border-radius: 10px;
}

QLabel#cardTitle {
    font-size: 10pt;
    font-weight: 600;
    color: #e7eaee;
}

/* Summary strip */
QFrame#summaryTile {
    background-color: #1f2329;
    border: 1px solid #2e343c;
    border-radius: 10px;
}

QFrame#summaryTile[highlight="true"] {
    background-color: #1c2633;
    border: 1px solid #2f5a8f;
}

QLabel#summaryLabel {
    font-size: 9pt;
    color: #9aa4b0;
}

QLabel#summaryValue {
    font-size: 18pt;
    font-weight: 600;
    color: #e7eaee;
}

QLabel#summaryValue[tone="danger"] {
    color: #ff7b7b;
}

QLabel#summaryHint {
    font-size: 9pt;
    font-weight: 500;
    color: #9aa4b0;
}

QLabel#summaryHint[tone="warning"] {
    color: #f0b429;
}

QLabel#summaryHint[tone="danger"] {
    color: #ff7b7b;
}

QPushButton#summaryLink {
    background-color: transparent;
    border: none;
    padding: 0px;
    text-align: left;
    font-size: 9pt;
    font-weight: 500;
    color: #5aa6ff;
}

QPushButton#summaryLink:hover {
    color: #8cc2ff;
}

/* Stale banner */
QFrame#staleBanner {
    background-color: #2a2516;
    border: 1px solid #5a4a1c;
    border-radius: 8px;
}

QLabel#staleBannerText {
    font-size: 9pt;
    color: #f0d38a;
}

QFrame#staleBanner QPushButton#linkButton {
    color: #ffd77a;
}

QFrame#staleBanner QPushButton#linkButton:hover {
    color: #ffe6ad;
}

/* Assumptions strip */
QFrame#assumptionsStrip {
    background-color: #1f2329;
    border: 1px solid #2e343c;
    border-radius: 10px;
}

QLabel#assumptionsHeading {
    font-size: 9pt;
    font-weight: 600;
    color: #e7eaee;
}

QLabel#assumptionItem {
    font-size: 9pt;
    color: #9aa4b0;
}

/* Controls row */
QLabel#forecastTimestamp {
    font-size: 9pt;
    color: #7d8794;
}

/* Flat link-style button - banner "Recalculate", strip "Edit assumptions" */
QPushButton#linkButton {
    background-color: transparent;
    border: none;
    padding: 0px;
    font-size: 9pt;
    font-weight: 600;
    color: #5aa6ff;
}

QPushButton#linkButton:hover {
    color: #8cc2ff;
}

QPushButton#linkButton:disabled {
    color: #4f5763;
}

/* Yet-to-pay popover */
QFrame#schedulePopover {
    background-color: #252a31;
    border: 1px solid #3a414b;
    border-radius: 6px;
}

QLabel#popoverRow {
    font-size: 9pt;
    color: #c3cad3;
}

QLabel#popoverTotal {
    font-size: 9pt;
    font-weight: 600;
    color: #e7eaee;
}

QLabel#popoverMore,
QLabel#popoverEmpty {
    font-size: 9pt;
    color: #7d8794;
}

QFrame#popoverSeparator {
    border: none;
    border-top: 1px solid #2a3038;
    max-height: 1px;
}

/* ============================================================
   ANALYSIS - TRENDS
   ============================================================ */

QTableView#tableFooter {
    background-color: #252a31;
    border: 1px solid #2e343c;
    border-radius: 8px;
    font-weight: 600;
    color: #e7eaee;
}

QLabel#breadcrumbLabel {
    font-size: 10pt;
    font-weight: 600;
    color: #e7eaee;
}

QLabel#rangeError {
    font-size: 9pt;
    color: #ff7b7b;
}

/* Analysis tab bar */
QPushButton#viewTab {
    background-color: transparent;
    border: none;
    border-bottom: 2px solid transparent;
    padding: 9px 16px;
    font-size: 10pt;
    font-weight: 500;
    color: #9aa4b0;
}

QPushButton#viewTab:hover {
    color: #e7eaee;
}

QPushButton#viewTab:checked {
    font-weight: 600;
    color: #5aa6ff;
    border-bottom: 2px solid #5aa6ff;
}

QLabel#analysisWalletLabel {
    font-size: 9pt;
    color: #9aa4b0;
}

/* ============================================================
   ANALYSIS - MOCKUP 2a/2b LAYOUT
   ============================================================ */

/* Page header: title, wallet, tabs on the bottom border */
QFrame#analysisHeader {
    background-color: #1f2329;
    border: none;
    border-bottom: 1px solid #2e343c;
}

QLabel#analysisTitle {
    font-size: 16pt;
    font-weight: 600;
    color: #e7eaee;
}

/* Summary strip: one card, tiles split by a hairline */
QFrame#summaryStrip {
    background-color: #1f2329;
    border: 1px solid #2e343c;
    border-radius: 10px;
}

QFrame#summaryStrip QFrame#summaryTile {
    background-color: transparent;
    border: none;
    border-right: 1px solid #2e343c;
    border-radius: 0px;
}

QFrame#summaryStrip QFrame#summaryTile[last="true"] {
    border-right: none;
}

QFrame#summaryStrip QFrame#summaryTile[highlight="true"] {
    background-color: #1c2633;
    border: 1px solid #2f5a8f;
}

/* Stale banner bullet */
QLabel#staleBannerDot {
    font-size: 8pt;
    color: #f0b429;
}

/* Chart legend row */
QLabel#chartLegendItem {
    font-size: 9pt;
    color: #b4bcc6;
}

QLabel#chartNote {
    font-size: 9pt;
    color: #7d8794;
}

/* Tables inside analysis cards: the card draws the border */
QFrame#analysisCard QTableView {
    background-color: transparent;
    border: none;
    border-radius: 10px;
}

/* 8px, the same as the header and the painting delegates, so a value
   and its column title share a right edge. */
QFrame#analysisCard QTableView::item {
    padding: 0px 8px;
    border-bottom: 1px solid #2a3038;
}

QTableView#tableFooter::item {
    padding: 0px 8px;
    border: none;
}

QFrame#analysisCard QHeaderView::section {
    background-color: #252a31;
    color: #b4bcc6;
    padding: 9px 8px;
    border: none;
    border-bottom: 1px solid #2e343c;
    font-weight: 600;
    font-size: 12px;
}

QFrame#analysisCard QHeaderView::section:hover {
    background-color: #252a31;
    color: #b4bcc6;
}
