/* 
   FINANLIST - LIGHT THEME

   Palette tokens (for reference - QSS has no variables):

     #ffffff  base         main window, cards, tables, dialogs
     #f0f0f0  sidebar      navigation rail
     #f7f7f7  surface_alt  table header, panels
     #f5f5f5  surface_sub  quiet fills, hover
     #e8e8e8  surface_hi   pressed / stronger hover
     #d9d9d9  border
     #bfbfbf  border_hi    hover / focus borders
     #ededed  separator
     #a6a6a6  muted        empty states
     #808080  text_3       tertiary text
     #5a5a5a  text_2       secondary text
     #1e1e1e  text_1       primary text
     #2a82da  accent

   Operation colours match app/core/theme/palette.py LIGHT, so a QSS-styled
   label and a delegate-painted cell show the same colour side by side.

   Section order matches dark.qss line for line - diff the two files to
   spot a rule that exists in only one theme.
    */


/* 
   1. GLOBAL
    */

QWidget {
    color: #1e1e1e;
    background-color: transparent;
    font-family: "Segoe UI";
    font-size: 14px;
}

/* Only top-level containers paint a background. Everything else is
   transparent and inherits, which is why there are no
   "SomeCard QWidget { background: transparent; }" rules anywhere below. */
QMainWindow {
    background-color: #ffffff;
}

QDialog {
    background-color: #ffffff;
}

QLabel {
    color: #1e1e1e;
}

QToolTip {
    background-color: #ffffff;
    color: #1e1e1e;
    border: 1px solid #bfbfbf;
    border-radius: 4px;
    padding: 4px 6px;
    font-size: 10pt;
}

/* --- Sidebar ------------------------------------------------------------ */
QFrame#sidebar {
    background-color: #f0f0f0;
}


/* 
   2. INPUT FIELDS
    */

/* Height clamp applies only to single-line controls. QTextEdit is excluded
   on purpose - it used to inherit max-height: 20px here, which silently
   crushed ResizableTextEdit and anything else subclassing QTextEdit. */
QComboBox,
QLineEdit,
QDateEdit {
    background-color: #ffffff;
    color: #1e1e1e;
    border: 2px solid #bfbfbf;
    border-radius: 10px;
    padding: 6px;
    min-height: 20px;
    max-height: 20px;
}

QComboBox {
    combobox-popup: 0;
}

QTextEdit {
    background-color: #ffffff;
    color: #1e1e1e;
    border: 2px solid #bfbfbf;
    border-radius: 10px;
    padding: 6px;
}

QTextEdit#Description {
    min-height: 58px;
    max-height: 58px;
}

QComboBox:focus,
QLineEdit:focus,
QDateEdit:focus,
QTextEdit:focus {
    border-color: #2a82da;
}

QComboBox:disabled,
QLineEdit:disabled,
QDateEdit:disabled,
QTextEdit:disabled {
    background-color: #f5f5f5;
    color: #a6a6a6;
    border-color: #ededed;
}

/* --- ComboBox / DateEdit drop-down ------------------------------------- */
QComboBox::drop-down,
QDateEdit::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    background-color: #e6e6e6;
    border-top-right-radius: 8px;
    border-bottom-right-radius: 8px;
}

QComboBox::down-arrow,
QDateEdit::down-arrow {
    image: url(svg:down_arrow_light.svg);
    width: 10px;
    height: 10px;
}

QComboBox QAbstractItemView {
    background-color: #ffffff;
    color: #1e1e1e;
    border: 2px solid #bfbfbf;
    border-radius: 5px;
    selection-background-color: #2a82da;
    selection-color: #ffffff;
    outline: 0;
}

QComboBox QAbstractItemView::item {
    border-radius: 5px;
    padding: 4px;
}

QComboBox QAbstractItemView::item:hover {
    background-color: #ededed;
}


/* 
   3. CHECKBOX

   Single-colon pseudo-states. The old ::checked / ::hover were sub-control
   syntax and never matched, so the tick never appeared.
    */

QCheckBox {
    color: #1e1e1e;
    spacing: 8px;
}

QCheckBox::indicator {
    width: 15px;
    height: 15px;
    border-radius: 4px;
    border: 2px solid #9a9a9a;
    background-color: #ffffff;
}

QCheckBox::indicator:hover {
    border-color: #2a82da;
}

QCheckBox::indicator:checked {
    background-color: #ffffff;
    border-color: #2a82da;
    image: url(svg:check_icon.svg);
}

QCheckBox::indicator:disabled {
    border-color: #ededed;
    background-color: #f5f5f5;
}

QCheckBox:disabled {
    color: #a6a6a6;
}


/* 
   4. MENUS
    */

QMenu {
    background-color: #ffffff;
    color: #1e1e1e;
    border: 2px solid #bfbfbf;
    border-radius: 10px;
    padding: 4px;
}

QMenu::item {
    padding: 6px 16px;
    border-radius: 6px;
}

QMenu::item:selected {
    background-color: #2a82da;
    color: #ffffff;
}

QMenu::separator {
    height: 1px;
    background-color: #ededed;
    margin: 4px 8px;
}

QMenu#DropDownMenu {
    border: 2px solid #b5c0c9;
    border-radius: 10px;
}


/* 
   5. SCROLLBARS (application-wide)
    */

QScrollBar:vertical {
    border: none;
    background-color: #ffffff;
    width: 12px;
    margin: 15px 0px 15px 0px;
}

QScrollBar::handle:vertical {
    background-color: #bfbfbf;
    border: 1px solid #bfbfbf;
    border-radius: 4px;
    min-height: 20px;
}

QScrollBar::handle:vertical:hover {
    background-color: #b3b3b3;
}

QScrollBar::handle:vertical:pressed {
    background-color: #999999;
}

QScrollBar::sub-line:vertical {
    border: 1px solid #bfbfbf;
    height: 15px;
    border-top-right-radius: 5px;
    subcontrol-position: top;
    subcontrol-origin: margin;
    image: url(svg:up_arrow_light.svg);
}

QScrollBar::add-line:vertical {
    border: 1px solid #bfbfbf;
    height: 15px;
    border-bottom-right-radius: 5px;
    subcontrol-position: bottom;
    subcontrol-origin: margin;
    image: url(svg:down_arrow_light.svg);
}

QScrollBar::sub-line:vertical:hover,
QScrollBar::add-line:vertical:hover {
    background-color: #b3b3b3;
}

QScrollBar::sub-line:vertical:pressed,
QScrollBar::add-line:vertical:pressed {
    background-color: #999999;
}

QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical {
    background: none;
}

/* --- Slim variant: scroll areas nested inside cards and dialogs --------
   One rule set instead of the near-identical copies that used to live in
   the due-dialog and settings sections. */
QFrame#dueTransactionRow QScrollBar:vertical,
QScrollArea#settingsScrollArea QScrollBar:vertical {
    background-color: transparent;
    width: 8px;
    margin: 0;
    border: none;
}

QFrame#dueTransactionRow QScrollBar::handle:vertical,
QScrollArea#settingsScrollArea QScrollBar::handle:vertical {
    background-color: #d0d0d0;
    border-radius: 4px;
    min-height: 24px;
}

QFrame#dueTransactionRow QScrollBar::handle:vertical:hover,
QScrollArea#settingsScrollArea QScrollBar::handle:vertical:hover {
    background-color: #b3b3b3;
}

QFrame#dueTransactionRow QScrollBar::add-line:vertical,
QFrame#dueTransactionRow QScrollBar::sub-line:vertical,
QScrollArea#settingsScrollArea QScrollBar::add-line:vertical,
QScrollArea#settingsScrollArea QScrollBar::sub-line:vertical {
    height: 0;
    background: none;
    border: none;
    image: none;
}

QFrame#dueTransactionRow QScrollBar::add-page:vertical,
QFrame#dueTransactionRow QScrollBar::sub-page:vertical,
QScrollArea#settingsScrollArea QScrollBar::add-page:vertical,
QScrollArea#settingsScrollArea QScrollBar::sub-page:vertical {
    background: none;
}


/* 
   6. QTABLEVIEW
    */

QTableView {
    background-color: #ffffff;
    color: #1e1e1e;
    border: 1px solid #d9d9d9;
    border-radius: 8px;
    gridline-color: transparent;
    selection-background-color: transparent;
    selection-color: #1e1e1e;
    outline: 0;
}

QTableView::item {
    padding: 10px 14px;
    border-bottom: 1px solid #ededed;
    border-radius: 0;
}

QTableView::item:hover {
    background-color: #f5f5f5;
}

QTableView::item:selected {
    background-color: #e8f0fb;
    color: #1e1e1e;
}

QTableView::item:selected:hover {
    background-color: #d9e6f7;
}

QTableView::item:focus {
    outline: 0;
    border: none;
}

/* --- Header ------------------------------------------------------------ */
QHeaderView {
    background-color: transparent;
    border: none;
}

QHeaderView::section {
    background-color: #f7f7f7;
    color: #5a5a5a;
    padding: 10px 14px;
    border: none;
    border-bottom: 1px solid #d9d9d9;
    font-weight: 500;
    font-size: 13px;
}

QHeaderView::section:hover {
    background-color: #ededed;
    color: #1e1e1e;
}

QHeaderView::section:first {
    border-top-left-radius: 8px;
}

QHeaderView::section:last {
    border-top-right-radius: 8px;
}

/* The sort indicator. These blocks previously set geometry but no image,
   so clicking a header produced no visible arrow at all. */
QHeaderView::down-arrow {
    image: url(svg:down_arrow_light.svg);
    subcontrol-origin: padding;
    subcontrol-position: center right;
    right: 8px;
    width: 10px;
    height: 10px;
}

QHeaderView::up-arrow {
    image: url(svg:up_arrow_light.svg);
    subcontrol-origin: padding;
    subcontrol-position: center right;
    right: 8px;
    width: 10px;
    height: 10px;
}

QTableCornerButton::section {
    background-color: #f7f7f7;
    border: none;
    border-bottom: 1px solid #d9d9d9;
}

/* --- Table scrollbars -------------------------------------------------- */
QTableView QScrollBar:vertical {
    background-color: transparent;
    width: 10px;
    margin: 4px 2px 4px 0;
    border: none;
}

QTableView QScrollBar::handle:vertical {
    background-color: #d0d0d0;
    border-radius: 4px;
    min-height: 30px;
}

QTableView QScrollBar::handle:vertical:hover {
    background-color: #b3b3b3;
}

QTableView QScrollBar::add-line:vertical,
QTableView QScrollBar::sub-line:vertical {
    height: 0;
    background: none;
    border: none;
    image: none;
}

QTableView QScrollBar:horizontal {
    background-color: transparent;
    height: 10px;
    margin: 0 4px 2px 4px;
    border: none;
}

QTableView QScrollBar::handle:horizontal {
    background-color: #d0d0d0;
    border-radius: 4px;
    min-width: 30px;
}

QTableView QScrollBar::handle:horizontal:hover {
    background-color: #b3b3b3;
}

QTableView QScrollBar::add-line:horizontal,
QTableView QScrollBar::sub-line:horizontal {
    width: 0;
    background: none;
    border: none;
    image: none;
}


/* 
   7. CALENDAR POPUP
    */

QCalendarWidget {
    background-color: #ffffff;
    border: 1px solid #d9d9d9;
    border-radius: 8px;
}

QCalendarWidget QWidget {
    alternate-background-color: transparent;
}

QCalendarWidget QWidget#qt_calendar_navigationbar {
    background-color: #f7f7f7;
    border-bottom: 1px solid #d9d9d9;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    padding: 4px 8px;
}

QCalendarWidget QToolButton {
    color: #1e1e1e;
    font-size: 13px;
    font-weight: 500;
    background-color: transparent;
    border: none;
    border-radius: 4px;
    padding: 4px 8px;
    margin: 2px;
}

QCalendarWidget QToolButton:hover {
    background-color: #e8e8e8;
}

QCalendarWidget QToolButton:pressed {
    background-color: #d9d9d9;
}

QCalendarWidget QToolButton#qt_calendar_prevmonth {
    qproperty-icon: none;
    qproperty-text: "\25C0";
    font-size: 10px;
    padding: 4px 8px;
}

QCalendarWidget QToolButton#qt_calendar_nextmonth {
    qproperty-icon: none;
    qproperty-text: "\25B6";
    font-size: 10px;
    padding: 4px 8px;
}

QCalendarWidget QMenu {
    background-color: #ffffff;
    color: #1e1e1e;
    border: 1px solid #d9d9d9;
    border-radius: 6px;
    padding: 4px;
}

QCalendarWidget QMenu::item {
    padding: 6px 16px;
    border-radius: 4px;
}

QCalendarWidget QMenu::item:selected {
    background-color: #2a82da;
    color: #ffffff;
}

/* --- Year spinbox ------------------------------------------------------ */
QCalendarWidget QSpinBox {
    color: #1e1e1e;
    background-color: #ffffff;
    border: 1px solid #d9d9d9;
    border-radius: 4px;
    padding: 2px 6px;
    font-size: 13px;
    selection-background-color: #2a82da;
    selection-color: #ffffff;
}

QCalendarWidget QSpinBox::up-button,
QCalendarWidget QSpinBox::down-button {
    subcontrol-origin: border;
    width: 18px;
    background-color: #e8e8e8;
    border: none;
}

QCalendarWidget QSpinBox::up-button {
    border-top-right-radius: 4px;
    subcontrol-position: top right;
}

QCalendarWidget QSpinBox::down-button {
    border-bottom-right-radius: 4px;
    subcontrol-position: bottom right;
}

QCalendarWidget QSpinBox::up-button:hover,
QCalendarWidget QSpinBox::down-button:hover {
    background-color: #d9d9d9;
}

/* These pointed at up_arrow.svg / down_arrow.svg - the {{ICON_COLOR}}
   templates, which render zero visible pixels. Baked variants only. */
QCalendarWidget QSpinBox::up-arrow {
    image: url(svg:up_arrow_light.svg);
    width: 8px;
    height: 8px;
}

QCalendarWidget QSpinBox::down-arrow {
    image: url(svg:down_arrow_light.svg);
    width: 8px;
    height: 8px;
}

/* --- Day grid ---------------------------------------------------------- */
QCalendarWidget QAbstractItemView:enabled {
    background-color: #ffffff;
    color: #1e1e1e;
    font-size: 13px;
    selection-background-color: #2a82da;
    selection-color: #ffffff;
    outline: 0;
    border: none;
}

QCalendarWidget QAbstractItemView:disabled {
    color: #b3b3b3;
}

QCalendarWidget QAbstractItemView::item {
    padding: 6px;
    margin: 1px;
    border-radius: 4px;
}

QCalendarWidget QAbstractItemView::item:hover {
    background-color: #f0f0f0;
}

QCalendarWidget QAbstractItemView::item:selected {
    background-color: #2a82da;
    color: #ffffff;
    border-radius: 4px;
}

QCalendarWidget QAbstractItemView::item:focus {
    background-color: #e8f0fb;
    border: 1px solid #2a82da;
    border-radius: 4px;
}

QCalendarWidget QWidget#qt_calendar_calendarview {
    background-color: #ffffff;
    border-bottom-left-radius: 8px;
    border-bottom-right-radius: 8px;
}


/* 
   8. BUTTONS - default look for buttons with no object name
    */

QPushButton,
QRadioButton {
    background-color: #969696;
    color: #1e1e1e;
    border: none;
    border-radius: 8px;
    padding: 6px 12px;
}

QPushButton:hover,
QRadioButton:hover {
    background-color: #b3b3b3;
}

QPushButton:pressed,
QRadioButton:pressed {
    background-color: #2a82da;
    color: #ffffff;
}

QPushButton:disabled {
    background-color: #f5f5f5;
    color: #b3b3b3;
}


/* 
   9. BUTTON VARIANTS - PushButton(object_name="primaryButton") etc.
    */

/* --- Primary ----------------------------------------------------------- */
QPushButton#primaryButton {
    background-color: #4dacff;
    color: #ffffff;
    border: 2px solid #4dacff;
    border-radius: 10px;
    font-size: 10pt;
    font-weight: bold;
    padding: 0px;
}

QPushButton#primaryButton:hover {
    background-color: #2b9bff;
    border-color: #2b9bff;
}

QPushButton#primaryButton:pressed {
    background-color: #0085fc;
    border-color: #0085fc;
    color: #ffffff;
}

QPushButton#primaryButton:disabled {
    background-color: #d9d9d9;
    border-color: #d9d9d9;
    color: #8c8c8c;
}

/* --- Secondary (outlined) ---------------------------------------------- */
QPushButton#secondaryButton {
    background-color: #ffffff;
    color: #4dacff;
    border: 2px solid #4dacff;
    border-radius: 10px;
    font-size: 10pt;
    font-weight: bold;
    padding: 0px;
}

QPushButton#secondaryButton:hover {
    background-color: #eef7ff;
}

QPushButton#secondaryButton:pressed {
    background-color: #0085fc;
    border-color: #0085fc;
    color: #ffffff;
}

QPushButton#secondaryButton:disabled {
    background-color: #ffffff;
    border-color: #d9d9d9;
    color: #b3b3b3;
}

/* --- Neutral ----------------------------------------------------------- */
QPushButton#neutralButton {
    background-color: #f5f5f5;
    color: #333333;
    border: 1px solid #d9d9d9;
    border-radius: 10px;
    font-size: 10pt;
    font-weight: bold;
    padding: 0px;
}

QPushButton#neutralButton:hover {
    background-color: #e8e8e8;
}

QPushButton#neutralButton:pressed {
    background-color: #d9d9d9;
    color: #1e1e1e;
}

QPushButton#neutralButton:disabled {
    background-color: #f5f5f5;
    border-color: #ededed;
    color: #b3b3b3;
}

/* --- Danger ------------------------------------------------------------ */
QPushButton#dangerButton,
QPushButton#dueSkipButton {
    background-color: #fdeaea;
    color: #c53030;
    border: 1px solid #f5c6c6;
    border-radius: 10px;
    font-size: 10pt;
    font-weight: bold;
    padding: 0px;
}

QPushButton#dangerButton:hover,
QPushButton#dueSkipButton:hover {
    background-color: #fad4d4;
    border-color: #e09a9a;
}

QPushButton#dangerButton:pressed,
QPushButton#dueSkipButton:pressed {
    background-color: #f5b3b3;
    color: #8b1a1a;
    border-color: #e09a9a;
}

QPushButton#dangerButton:disabled,
QPushButton#dueSkipButton:disabled {
    background-color: #f5f5f5;
    border-color: #ededed;
    color: #b3b3b3;
}

/* --- Link ("View all") ------------------------------------------------- */
QPushButton#viewAllButton {
    background: transparent;
    color: #2a82da;
    border: none;
    font-size: 11px;
    font-weight: 500;
    text-align: right;
    padding: 0px;
}

QPushButton#viewAllButton:hover {
    color: #1a5fb4;
    text-decoration: underline;
}

QPushButton#viewAllButton:pressed {
    background: transparent;
    color: #0d4a8a;
}

/* --- Profile circle ---------------------------------------------------- */
QPushButton#profileCircleButton {
    background-color: #ffffff;
    color: #1e1e1e;
    border: 2px solid #808080;
    border-radius: 60px;
    font-size: 25pt;
    font-weight: bold;
}

QPushButton#profileCircleButton:hover {
    background-color: #f5f5f5;
    border-color: #5a5a5a;
}

QPushButton#profileCircleButton:pressed {
    background-color: #d9d9d9;
}

/* --- Small size modifier ----------------------------------------------
   The bare QPushButton[size="small"] rule loses to every #objectName rule
   above, so each variant needs its own scoped copy or font_size does
   nothing on a themed button. */
QPushButton[size="small"] {
    font-size: 8pt;
    border-radius: 8px;
}

QPushButton#primaryButton[size="small"],
QPushButton#secondaryButton[size="small"],
QPushButton#neutralButton[size="small"],
QPushButton#dangerButton[size="small"],
QPushButton#dueSkipButton[size="small"] {
    font-size: 8pt;
    border-radius: 8px;
}


/* 
   10. SEPARATORS
    */

QFrame#hLine {
    border: none;
    border-top: 1px solid #ededed;
    max-height: 1px;
    min-height: 1px;
}

QFrame#vLine {
    border: none;
    border-left: 1px solid #ededed;
    max-width: 1px;
    min-width: 1px;
}

QFrame#hLine[emphasis="strong"] {
    border-top: 1px solid #bfbfbf;
}

QFrame#vLine[emphasis="strong"] {
    border-left: 1px solid #bfbfbf;
}


/* 
   11. SHARED LABELS
    */

QLabel#inputLabel {
    font-size: 13px;
    color: #1e1e1e;
}

QLabel#inputSubLabel {
    font-size: 11px;
    color: #808080;
}

QLabel#logoLabel {
    font-size: 25pt;
    color: #1e1e1e;
}

QLabel#transactionLabel {
    font-size: 18pt;
    font-weight: bold;
    color: #1e1e1e;
}

QLabel#infoBanner {
    background-color: #e8f0fb;
    color: #1a5fb4;
    border: 1px solid #bcd4f0;
    border-radius: 6px;
    padding: 8px 12px;
    font-size: 12px;
}

QLabel#not_tr_label {
    font-size: 11pt;
    font-weight: bold;
    color: #5a5a5a;
}

QLabel#main_category_label {
    font-size: 10.5pt;
    font-weight: bold;
    color: #1e1e1e;
}

QLabel#category_label {
    font-size: 10pt;
    color: #5a5a5a;
}


/* 
   12. OPERATION TYPE PILLS (QLabel form)

   The QTableView uses TypePillDelegate instead. These are for the places
   that still show an operation type as a plain label. Colours now come
   from palette.py's *_pill_bg / *_pill_text so a label pill and a delegate
   pill are the same colour. The old values (#ff3333 on #ffcccc etc.) were
   pre-refactor and no longer matched anything.
    */

QLabel#Income,
QLabel#Expense,
QLabel#Saving,
QLabel#Investment {
    font-size: 10pt;
    border-radius: 8px;
    padding: 2px 8px;
}

QLabel#Income {
    color: #085041;
    background-color: #e1f5ee;
    border: 1px solid #e1f5ee;
}

QLabel#Expense {
    color: #791f1f;
    background-color: #fcebeb;
    border: 1px solid #fcebeb;
}

QLabel#Saving {
    color: #3c3489;
    background-color: #eeedfe;
    border: 1px solid #eeedfe;
}

QLabel#Investment {
    color: #633806;
    background-color: #faeeda;
    border: 1px solid #faeeda;
}


/* 
   13. WALLET CARDS
    */

QFrame#walletCard {
    border-radius: 12px;
    padding: 5px;
}

/* Active card - same gradient in both themes */
QFrame#walletCard[active="true"] {
    background: qlineargradient(
        x1: 0, y1: 0, x2: 1, y2: 1,
        stop: 0 #1a5fb4,
        stop: 1 #2a82da
    );
    border: none;
}

QFrame#walletCard[active="false"] {
    background-color: #ffffff;
    border: 1px solid #d9d9d9;
}

QFrame#walletCard[active="true"] QLabel {
    color: #ffffff;
}

QFrame#walletCard[active="false"] QLabel {
    color: #1e1e1e;
}

QFrame#walletCard[active="true"] QLabel#walletCardMuted,
QFrame#walletCard[active="true"] QLabel#walletCardCurrency {
    color: rgba(255, 255, 255, 0.6);
}

QFrame#walletCard[active="false"] QLabel#walletCardMuted,
QFrame#walletCard[active="false"] QLabel#walletCardCurrency {
    color: #808080;
}

QLabel#walletCardName {
    font-size: 20px;
    font-weight: 600;
}

QLabel#walletCardBalance {
    font-size: 22px;
    font-weight: 500;
}

QFrame#walletCard[active="true"] QLabel#walletActiveBadge {
    background-color: rgba(255, 255, 255, 0.25);
    color: #ffffff;
    padding: 2px 10px;
    border-radius: 8px;
    font-size: 11px;
}

/* --- Wallet card buttons ----------------------------------------------- */
QPushButton#walletCardBtnPrimary {
    background-color: #e8f0fb;
    color: #1a5fb4;
    border: 1px solid #bcd4f0;
    border-radius: 6px;
    font-size: 11px;
    font-weight: bold;
    padding: 0px;
}

QPushButton#walletCardBtnPrimary:hover {
    background-color: #d4e4f7;
    border-color: #bcd4f0;
}

QPushButton#walletCardBtnPrimary:pressed {
    background-color: #bcd4f0;
    color: #0d4a8a;
    border-color: #9abde0;
}

QPushButton#walletCardBtnNeutral {
    background-color: #f5f5f5;
    color: #333333;
    border: 1px solid #d9d9d9;
    border-radius: 6px;
    font-size: 11px;
    font-weight: bold;
    padding: 0px;
}

QPushButton#walletCardBtnNeutral:hover {
    background-color: #e8e8e8;
    border-color: #bfbfbf;
}

QPushButton#walletCardBtnNeutral:pressed {
    background-color: #d9d9d9;
    color: #1e1e1e;
    border-color: #bfbfbf;
}

QPushButton#walletCardBtnDanger {
    background-color: #fdeaea;
    color: #c53030;
    border: 1px solid #f5c6c6;
    border-radius: 6px;
    font-size: 11px;
    font-weight: bold;
    padding: 0px;
}

QPushButton#walletCardBtnDanger:hover {
    background-color: #fad4d4;
    border-color: #e09a9a;
}

QPushButton#walletCardBtnDanger:pressed {
    background-color: #f5b3b3;
    color: #8b1a1a;
    border-color: #e09a9a;
}

/* Buttons on the active card's gradient - identical in both themes */
QPushButton#walletCardBtnOnGradient {
    background-color: rgba(255, 255, 255, 0.2);
    color: #ffffff;
    border: 1px solid rgba(255, 255, 255, 0.35);
    border-radius: 6px;
    font-size: 11px;
    font-weight: bold;
    padding: 0px;
}

QPushButton#walletCardBtnOnGradient:hover {
    background-color: rgba(255, 255, 255, 0.35);
    border-color: rgba(255, 255, 255, 0.45);
}

QPushButton#walletCardBtnOnGradient:pressed {
    background-color: rgba(255, 255, 255, 0.5);
    border-color: rgba(255, 255, 255, 0.55);
}

QPushButton#addWalletBtn {
    background-color: transparent;
    color: #888888;
    border: 2px solid #d0d0d0;
    border-radius: 12px;
    font-size: 14px;
    font-weight: bold;
    padding: 14px;
}

QPushButton#addWalletBtn:hover {
    background-color: #f5f5f5;
    color: #555555;
    border-color: #b0b0b0;
}

QPushButton#addWalletBtn:pressed {
    background-color: #e0e0e0;
    color: #333333;
    border-color: #999999;
}

QPushButton#walletCardBtnPrimary:disabled,
QPushButton#walletCardBtnNeutral:disabled,
QPushButton#walletCardBtnDanger:disabled,
QPushButton#addWalletBtn:disabled {
    background-color: #f5f5f5;
    color: #b3b3b3;
    border-color: #ededed;
}

QPushButton#walletCardBtnOnGradient:disabled {
    background-color: rgba(255, 255, 255, 0.08);
    color: rgba(255, 255, 255, 0.4);
    border-color: rgba(255, 255, 255, 0.15);
}


/* 
   14. DASHBOARD
    */

QFrame#balanceTile,
QFrame#monthTile,
QFrame#dueTile,
QFrame#categoryBars,
QFrame#recentOperationsCard,
QFrame#upcomingCard {
    background-color: #ffffff;
    border: 1px solid #d9d9d9;
    border-radius: 10px;
}

QFrame#dueTile[alert="true"] {
    border: 1px solid #f5c6c6;
}

/* --- Greeting row ------------------------------------------------------ */
QLabel#dashboardNameLabel {
    font-size: 18px;
    font-weight: 600;
    color: #1e1e1e;
}

QLabel#dashboardDate {
    font-size: 12px;
    color: #808080;
}

/* --- Shared tile captions ---------------------------------------------- */
QLabel#balanceTileLabel,
QLabel#monthTileTopLabel,
QLabel#dueTileLabel {
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 1px;
    color: #808080;
}

/* --- Balance tile ------------------------------------------------------ */
QLabel#balanceTileAmount {
    font-size: 24px;
    font-weight: 600;
    color: #1e1e1e;
}

QLabel#balanceTileWallet {
    font-size: 11px;
    color: #808080;
}

/* --- Month tile -------------------------------------------------------- */
QLabel#monthTileMiddleLabel {
    font-size: 13px;
    color: #5a5a5a;
}

QLabel#monthTileBottomLabel {
    font-size: 13px;
    font-weight: 600;
    color: #1e1e1e;
}

QLabel#monthTileIncome {
    font-size: 13px;
    font-weight: 500;
    color: #0f6e56;
}

QLabel#monthTileExpense {
    font-size: 13px;
    font-weight: 500;
    color: #a32d2d;
}

QLabel#monthTileNet {
    font-size: 13px;
    font-weight: 600;
}

QLabel#monthTileNet[positive="true"] {
    color: #0f6e56;
}

QLabel#monthTileNet[positive="false"] {
    color: #a32d2d;
}

/* --- Due tile ---------------------------------------------------------- */
QLabel#dueTileDueNum {
    font-size: 20px;
    font-weight: 600;
    color: #1e1e1e;
}

QFrame#dueTile[alert="true"] QLabel#dueTileDueNum {
    color: #a32d2d;
}

QLabel#dueTileBottom {
    font-size: 11px;
    color: #808080;
}

/* --- Category bars ----------------------------------------------------- */
QLabel#categoryBarsTitle {
    font-size: 14px;
    font-weight: 600;
    color: #1e1e1e;
}

QLabel#categoryBarsMonth,
QLabel#categoryBarsTotal {
    font-size: 11px;
    color: #808080;
}

QLabel#categoryBarName {
    font-size: 13px;
    color: #5a5a5a;
}

QLabel#categoryBarTotal {
    font-size: 13px;
    color: #1e1e1e;
}

QLabel#categoryBarsEmptyState {
    font-size: 12px;
    color: #a6a6a6;
}

/* Fill colour stays inline - it is per-category data, not theme */
QFrame#barTrack {
    background-color: #ededed;
    border: none;
    border-radius: 4px;
}

QWidget#barSpacer {
    background: transparent;
}

/* --- List cards -------------------------------------------------------- */
QLabel#recOperTitle,
QLabel#upcCardTitle {
    font-size: 14px;
    font-weight: 600;
    color: #1e1e1e;
}

QLabel#recOperRowTitle,
QLabel#upcCardRowTitle {
    font-size: 13px;
    color: #1e1e1e;
}

QLabel#recOperRowDate,
QLabel#upcCardRowDate,
QLabel#recOperRowMerchant {
    font-size: 12px;
    color: #808080;
}

QLabel#recOperRowAmount,
QLabel#upcCardRowAmount {
    font-size: 13px;
    font-weight: 500;
}

QLabel#recOperRowAmount[positive="true"],
QLabel#upcCardRowAmount[positive="true"] {
    color: #0f6e56;
}

QLabel#recOperRowAmount[positive="false"],
QLabel#upcCardRowAmount[positive="false"] {
    color: #a32d2d;
}

QLabel#recOperEmptyState,
QLabel#upcCardEmptyState {
    font-size: 12px;
    color: #a6a6a6;
}


/* 
   15. DUE TRANSACTIONS DIALOG
    */

QLabel#dueDialogTitle {
    font-size: 16px;
    font-weight: 600;
    color: #1e1e1e;
}

QLabel#dueDialogSubtitle {
    font-size: 12px;
    color: #5a5a5a;
}

QFrame#dueTransactionRow {
    background-color: #ffffff;
    border: 2px solid #d9d9d9;
    border-radius: 8px;
}

QLabel#dueRowTitle {
    font-size: 14px;
    font-weight: 600;
    color: #1e1e1e;
}

/* Interval chip - this existed only in light.qss before */
QLabel#dueRowInterval {
    font-size: 12px;
    color: #5a5a5a;
    background-color: #ededed;
    border: 1px solid #d9d9d9;
    border-radius: 10px;
    padding: 0px 10px;
}

QLabel#dueRowCount,
QLabel#dueRowSummary {
    font-size: 11px;
    color: #808080;
}

QLabel#dueRowAmount {
    font-size: 13px;
    font-weight: 600;
}

QLabel#dueRowAmount[operation="income"] {
    color: #0f6e56;
}

QLabel#dueRowAmount[operation="expense"] {
    color: #a32d2d;
}

QLabel#dueRowAmount[operation="saving"] {
    color: #534ab7;
}

QLabel#dueRowAmount[operation="investment"] {
    color: #854f0b;
}

QLabel#occurrenceDate {
    font-size: 13px;
    color: #1e1e1e;
}

QLabel#occurrenceTimeline {
    font-size: 11px;
    color: #808080;
}

QLabel#occurrenceTimeline[overdue="true"] {
    color: #a32d2d;
}


/* 
   16. PROFILE DIALOG
    */

QLabel#profileDialogTitle {
    font-size: 17px;
    font-weight: 600;
    color: #1e1e1e;
}

QLabel#profileDialogSubtitle {
    font-size: 12px;
    color: #808080;
}

QLabel#profileDialogInitial {
    background-color: #ffffff;
    color: #1e1e1e;
    border: 2px solid #808080;
    border-radius: 40px;
    font-size: 25pt;
    font-weight: bold;
}

QLabel#profileDialogNameLabel {
    font-size: 15px;
    font-weight: 600;
    color: #1e1e1e;
}

QLabel#profileDialogMemberLabel {
    font-size: 11px;
    color: #808080;
}

QWidget#profileSummary {
    background-color: #f7f7f7;
    border: 1px solid #ededed;
    border-radius: 10px;
}

QLabel#leftMonthTitle,
QLabel#savingsRateLabel {
    font-size: 11px;
    color: #808080;
}

QLabel#leftMonthAmount,
QLabel#savingsRateAmount {
    font-size: 19px;
    font-weight: 600;
    color: #1e1e1e;
}

QLabel#leftMonthAmount[positive="true"],
QLabel#savingsRateAmount[positive="true"] {
    color: #0f6e56;
}

QLabel#leftMonthAmount[positive="false"],
QLabel#savingsRateAmount[positive="false"] {
    color: #a32d2d;
}

/* Legacy - Settings moved to #settingsApplyNote. Drop if unreferenced. */
QLabel#profileUnsaved {
    font-size: 11px;
    color: #b07d2b;
}


/* 
   17. SETTINGS DIALOG
    */

QDialog#settingsDialog {
    background-color: #ffffff;
}

QLabel#settingsDialogTitle {
    font-size: 17px;
    font-weight: 600;
    color: #1e1e1e;
}

QLabel#settingsDialogSubtitle {
    font-size: 12px;
    color: #808080;
}

QLabel#settingsSectionLabel {
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 1px;
    color: #808080;
    margin-top: 10px;
}

QLabel#settingsApplyNote {
    font-size: 11px;
    color: #808080;
}

QScrollArea#settingsScrollArea {
    background: transparent;
    border: none;
}


/* 
   18. LEGACY - pre-refactor widgets

   Scoped under QTableWidget so the old header rule no longer competes with
   the QTableView one in section 6. Delete this whole block once nothing
   references QTableWidget or ResizableTextEdit.
    */

QTableWidget {
    background-color: #ffffff;
    color: #1e1e1e;
    border: 1px solid #bfbfbf;
    gridline-color: #d9d9d9;
}

QTableWidget::item:selected {
    background-color: #bfbfbf;
    color: #1e1e1e;
}

QTableWidget QHeaderView::section {
    background-color: #f0f0f0;
    color: #1e1e1e;
    border: 1px solid #bfbfbf;
    padding: 4px;
}

ResizableTextEdit {
    background-color: #ffffff;
    color: #1e1e1e;
    border: 2px solid #bfbfbf;
    border-radius: 10px;
    padding: 6px;
}

/* Segmented control  */
QFrame#segmentedTrack {
    background-color: #e9ecf0;     
    border: none;
    border-radius: 7px;
}

QPushButton#segmentButton {
    background-color: transparent;
    color: #4a525c;                  
    border: none;
    border-radius: 5px;
    padding: 4px 12px;
    font-size: 12px;
    font-weight: 500;
}

QPushButton#segmentButton:hover {
    color: #1e1e1e;           
}

QPushButton#segmentButton:checked {
    background-color: #ffffff;       
    color: #1e1e1e;              
    font-weight: 600;
}

QPushButton#segmentButton:pressed {
    background-color: #d9d9d9;      
}

QPushButton#segmentButton:disabled {
    color: #b3b3b3;   
}

/* ANALYSIS - FORECAST*/

/* Cards */
QFrame#analysisCard {
    background-color: #ffffff;
    border: 1px solid #e3e6ea;
    border-radius: 10px;
}

QLabel#cardTitle {
    font-size: 10pt;
    font-weight: 600;
    color: #1d232b;
}

/* Summary strip */
QFrame#summaryTile {
    background-color: #ffffff;
    border: 1px solid #e3e6ea;
    border-radius: 10px;
}

QFrame#summaryTile[highlight="true"] {
    background-color: #f7faff;
    border: 1px solid #9cc3f3;
}

QLabel#summaryLabel {
    font-size: 9pt;
    color: #66707c;
}

QLabel#summaryValue {
    font-size: 18pt;
    font-weight: 600;
    color: #1d232b;
}

QLabel#summaryValue[tone="danger"] {
    color: #c62f2f;
}

QLabel#summaryHint {
    font-size: 9pt;
    font-weight: 500;
    color: #66707c;
}

QLabel#summaryHint[tone="warning"] {
    color: #a86a00;
}

QLabel#summaryHint[tone="danger"] {
    color: #c62f2f;
}

QPushButton#summaryLink {
    background-color: transparent;
    border: none;
    padding: 0px;
    text-align: left;
    font-size: 9pt;
    font-weight: 500;
    color: #0a6fe0;
}

QPushButton#summaryLink:hover {
    color: #0857b0;
}

/* Stale banner */
QFrame#staleBanner {
    background-color: #fff7e0;
    border: 1px solid #efd58c;
    border-radius: 8px;
}

QLabel#staleBannerText {
    font-size: 9pt;
    color: #6e5200;
}

QFrame#staleBanner QPushButton#linkButton {
    color: #7a5a00;
}

QFrame#staleBanner QPushButton#linkButton:hover {
    color: #4d3800;
}

/* Assumptions strip */
QFrame#assumptionsStrip {
    background-color: #ffffff;
    border: 1px solid #e3e6ea;
    border-radius: 10px;
}

QLabel#assumptionsHeading {
    font-size: 9pt;
    font-weight: 600;
    color: #1d232b;
}

QLabel#assumptionItem {
    font-size: 9pt;
    color: #66707c;
}

/* Controls row */
QLabel#forecastTimestamp {
    font-size: 9pt;
    color: #66707c;
}

/* Flat link-style button - banner "Recalculate", strip "Edit assumptions" */
QPushButton#linkButton {
    background-color: transparent;
    border: none;
    padding: 0px;
    font-size: 9pt;
    font-weight: 600;
    color: #0a6fe0;
}

QPushButton#linkButton:hover {
    color: #0857b0;
}

QPushButton#linkButton:disabled {
    color: #a3aab3;
}

/* Yet-to-pay popover */
QFrame#schedulePopover {
    background-color: #ffffff;
    border: 1px solid #cfd5dc;
    border-radius: 6px;
}

QLabel#popoverRow {
    font-size: 9pt;
    color: #1d232b;
}

QLabel#popoverTotal {
    font-size: 9pt;
    font-weight: 600;
    color: #1d232b;
}

QLabel#popoverMore,
QLabel#popoverEmpty {
    font-size: 9pt;
    color: #7a838e;
}

QFrame#popoverSeparator {
    border: none;
    border-top: 1px solid #eceff3;
    max-height: 1px;
}

/* ============================================================
   ANALYSIS - TRENDS
   ============================================================ */

QTableView#tableFooter {
    background-color: #f3f5f7;
    border: 1px solid #e3e6ea;
    border-radius: 8px;
    font-weight: 600;
    color: #1d232b;
}

QLabel#breadcrumbLabel {
    font-size: 10pt;
    font-weight: 600;
    color: #1d232b;
}

QLabel#rangeError {
    font-size: 9pt;
    color: #c62f2f;
}

/* Analysis tab bar */
QPushButton#viewTab {
    background-color: transparent;
    border: none;
    border-bottom: 2px solid transparent;
    padding: 9px 16px;
    font-size: 10pt;
    font-weight: 500;
    color: #66707c;
}

QPushButton#viewTab:hover {
    color: #1d232b;
}

QPushButton#viewTab:checked {
    font-weight: 600;
    color: #0a6fe0;
    border-bottom: 2px solid #0a6fe0;
}

QLabel#analysisWalletLabel {
    font-size: 9pt;
    color: #66707c;
}

/* ============================================================
   ANALYSIS - MOCKUP 2a/2b LAYOUT
   ============================================================ */

/* Page header: title, wallet, tabs on the bottom border */
QFrame#analysisHeader {
    background-color: #ffffff;
    border: none;
    border-bottom: 1px solid #e3e6ea;
}

QLabel#analysisTitle {
    font-size: 16pt;
    font-weight: 600;
    color: #1d232b;
}

/* Summary strip: one card, tiles split by a hairline */
QFrame#summaryStrip {
    background-color: #ffffff;
    border: 1px solid #e3e6ea;
    border-radius: 10px;
}

QFrame#summaryStrip QFrame#summaryTile {
    background-color: transparent;
    border: none;
    border-right: 1px solid #e3e6ea;
    border-radius: 0px;
}

QFrame#summaryStrip QFrame#summaryTile[last="true"] {
    border-right: none;
}

QFrame#summaryStrip QFrame#summaryTile[highlight="true"] {
    background-color: #f7faff;
    border: 1px solid #9cc3f3;
}

/* Stale banner bullet */
QLabel#staleBannerDot {
    font-size: 8pt;
    color: #e0a100;
}

/* Chart legend row */
QLabel#chartLegendItem {
    font-size: 9pt;
    color: #4a525c;
}

QLabel#chartNote {
    font-size: 9pt;
    color: #7a838e;
}

/* Tables inside analysis cards: the card draws the border */
QFrame#analysisCard QTableView {
    background-color: transparent;
    border: none;
    border-radius: 10px;
}

/* 8px, the same as the header and the painting delegates, so a value
   and its column title share a right edge. */
QFrame#analysisCard QTableView::item {
    padding: 0px 8px;
    border-bottom: 1px solid #eceff3;
}

QTableView#tableFooter::item {
    padding: 0px 8px;
    border: none;
}

QFrame#analysisCard QHeaderView::section {
    background-color: #f3f5f7;
    color: #4a525c;
    padding: 9px 8px;
    border: none;
    border-bottom: 1px solid #e3e6ea;
    font-weight: 600;
    font-size: 12px;
}

QFrame#analysisCard QHeaderView::section:hover {
    background-color: #f3f5f7;
    color: #4a525c;
}
