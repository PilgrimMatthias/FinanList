/* ==========================================
   LIGHT THEME
   ========================================== */

/* --- Global --- */
QMainWindow {
    background-color: #ffffff;
}

QWidget {
    color: #000000;
    background-color: #ffffff;
    font-family: "Segoe UI";
    font-size: 14px;
}

QToolTip {
    background-color: #ffffff;
    color: #000000;
    padding: 2px;
    font-size: 10pt;
    border: 1px solid #bfbfbf;
}

/* --- Sidebar --- */
QFrame#sidebar {
    background-color: #f0f0f0;
}

/* --- Input Fields --- */
QComboBox,
QLineEdit,
QTextEdit,
QDateEdit {
    background-color: #ffffff;
    color: #000000;
    border: 2px solid #bfbfbf;
    border-radius: 10px;
    padding: 6px;
    combobox-popup: 0;
    min-height: 20px;
    max-height: 20px;
}
QTextEdit#Description{
    background-color: #ffffff;
    color: #000000;
    border: 2px solid #bfbfbf;
    border-radius: 10px;
    padding: 6px;
    combobox-popup: 0;
    min-height: 58px;
    max-height: 58px;
}



QComboBox:focus,
QTextEdit:focus,
QLineEdit:focus,
QDateEdit:focus {
    border-color: #2a82da;
}

QComboBox::placeholder,
QLineEdit::placeholder {
    color: #a6a6a6;
}

/* --- ComboBox Dropdown --- */
QComboBox QAbstractItemView {
    background-color: #ffffff;
    color: #000000;
    border: 2px solid #bfbfbf;
    border-radius: 5px;
}

QComboBox QAbstractItemView::item {
    border-radius: 5px;
    padding: 4px;
}

QComboBox QAbstractItemView::item:hover {
    background-color: #bfbfbf;
}

QComboBox::drop-down,
QDateEdit::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    background-color: #e6e6e6;
    border-top-right-radius: 8px;
    border-bottom-right-radius: 8px;
}

QComboBox::down-arrow,
QDateEdit::down-arrow {
    image: url(images:down_icon.png);
}

/* --- Buttons --- */
QPushButton, QRadioButton {
    background-color: #969696;
    color: #000000;
    border: none;
    border-radius: 8px;
    padding: 6px 12px;
}

QPushButton:hover, QRadioButton:hover {
    background-color: #b3b3b3;
}

QPushButton:pressed, QRadioButton:pressed {
    background-color: #2a82da;
    color: #ffffff;
}

/* --- Scrollbar Vertical --- */
QScrollBar:vertical {
    border: none;
    background-color: #ffffff;
    width: 12px;
    margin: 15px 0px 15px 0px;
}

QScrollBar::handle:vertical {
    background-color: #bfbfbf;
    border: 1px solid #bfbfbf;
    border-radius: 4px;
    min-height: 20px;
}

QScrollBar::handle:vertical:hover {
    background-color: #b3b3b3;
}

QScrollBar::handle:vertical:pressed {
    background-color: #999999;
}

QScrollBar::sub-line:vertical {
    border: 1px solid #bfbfbf;
    height: 15px;
    border-top-right-radius: 5px;
    subcontrol-position: top;
    subcontrol-origin: margin;
    image: url(images:up_icon.png);
}

QScrollBar::add-line:vertical {
    border: 1px solid #bfbfbf;
    height: 15px;
    border-bottom-right-radius: 5px;
    subcontrol-position: bottom;
    subcontrol-origin: margin;
    image: url(images:down_icon.png);
}

QScrollBar::sub-line:vertical:hover,
QScrollBar::add-line:vertical:hover {
    background-color: #b3b3b3;
}

QScrollBar::sub-line:vertical:pressed,
QScrollBar::add-line:vertical:pressed {
    background-color: #999999;
}

QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical {
    background: none;
}

/* --- Checkbox --- */
QCheckBox {
    color: #000000;
}

QCheckBox::indicator {
    width: 15px;
    height: 15px;
    border-radius: 4px;
    border: 2px solid #9a9a9a;
    background-color: #ffffff;
}
QCheckBox::indicator::checked{
    border-color: #2a82da;
    image: url(svg:check_icon.svg)
}
QCheckBox::indicator::hover{
    border-color: #2a82da;
}

/* --- Table --- */
QTableWidget {
    background-color: #ffffff;
    color: #000000;
    border: 1px solid #bfbfbf;
    gridline-color: #d9d9d9;
}

QTableWidget::item:selected {
    background-color: #bfbfbf;
    color: #000000;
}

QHeaderView::section {
    background-color: #f0f0f0;
    color: #000000;
    border: 1px solid #bfbfbf;
    padding: 4px;
}

/* --- Labels --- */
QLabel {
    color: #000000;
}

/* --- Menu --- */
QMenu {
    background-color: #ffffff;
    color: #000000;
    border: 2px solid #bfbfbf;
    border-radius: 10px;
}

QMenu::item:selected {
    background-color: #bfbfbf;
}

QPushButton#profileCircleButton {
    background-color: #ffffff;
    border: 2px solid #808080;
    border-radius: 60px;
    font-size: 25pt;
    font-weight: bold;
}

QPushButton:pressed#profileCircleButton {
    background-color: #d9d9d9;
}


QLabel#logoLabel { font-size: 25pt; color: #000000; }

ResizableTextEdit {
    background-color: #ffffff;
    color: #000000;
    border: 2px solid #bfbfbf;
    border-radius: 10px;
    padding: 6px;
}


QLabel#transactionLabel { font-size: 18pt; font-weight:bold; color: #000000;}

QLabel#not_tr_label { font-size: 11pt; font-weight:bold;}

QLabel#main_category_label{
    font-size: 10.5pt;
    font-weight:bold;
}

QLabel#category_label{
    font-size: 10pt;
}

QLabel#Expense {
    font-size: 10pt; 
    color: #ff3333; 
    background-color:#ffcccc; 
    border:1px solid #ffcccc; 
    border-radius: 8px;
}

QLabel#Income {
    font-size: 10pt; 
    color: #008000; 
    background-color:#b3ffb3; 
    border:1px solid #b3ffb3; 
    border-radius: 8px;
}

QLabel#Investment {
    font-size: 10pt; 
    color: #0f1f70; 
    background-color:#bcc5f6; 
    border:1px solid #bcc5f6; 
    border-radius: 8px;
}

QLabel#Saving {
    font-size: 10pt; 
    color: #1e65c8; 
    background-color:#bdd4f5; 
    border:1px solid #bdd4f5; 
    border-radius: 8px;
}

QMenu#DropDownMenu {
    border: 2px solid #b5c0c9; 
    border-radius:10px;
    }


/* ==========================================
   QTABLEVIEW STYLING - LIGHT THEME
   Append to light.qss
   ========================================== */

QTableView {
    background-color: #ffffff;
    color: #1e1e1e;
    border: 0.5px solid #d9d9d9;
    border-radius: 8px;
    gridline-color: transparent;
    selection-background-color: transparent;
    selection-color: #1e1e1e;
    outline: 0;
}

QTableView::item {
    padding: 10px 14px;
    border-bottom: 0.5px solid #ededed;
    border-radius: 0;
}

QTableView::item:hover {
    background-color: #f5f5f5;
}

QTableView::item:selected {
    background-color: #e8f0fb;
    color: #1e1e1e;
}

QTableView::item:selected:hover {
    background-color: #d9e6f7;
}

QTableView::item:focus {
    outline: 0;
    border: none;
}

/* --- Header --- */
QHeaderView {
    background-color: transparent;
    border: none;
}

QHeaderView::section {
    background-color: #f7f7f7;
    color: #5a5a5a;
    padding: 10px 14px;
    border: none;
    border-bottom: 0.5px solid #d9d9d9;
    font-weight: 500;
    font-size: 13px;
}

QHeaderView::section:hover {
    background-color: #ededed;
    color: #1e1e1e;
}

QHeaderView::section:first {
    border-top-left-radius: 8px;
}

QHeaderView::section:last {
    border-top-right-radius: 8px;
}

QHeaderView::down-arrow,
QHeaderView::up-arrow {
    subcontrol-position: center right;
    subcontrol-origin: padding;
    right: 8px;
    width: 10px;
    height: 10px;
}


/* --- Corner button (top-left, between headers and scrollbars) --- */
QTableCornerButton::section {
    background-color: #f7f7f7;
    border: none;
    border-bottom: 0.5px solid #d9d9d9;
}

/* --- Scrollbars (for table) --- */
QTableView QScrollBar:vertical {
    background-color: transparent;
    width: 10px;
    margin: 4px 2px 4px 0;
    border: none;
}

QTableView QScrollBar::handle:vertical {
    background-color: #d0d0d0;
    border-radius: 4px;
    min-height: 30px;
}

QTableView QScrollBar::handle:vertical:hover {
    background-color: #b3b3b3;
}

QTableView QScrollBar::add-line:vertical,
QTableView QScrollBar::sub-line:vertical {
    height: 0;
    background: none;
    border: none;
}

QTableView QScrollBar:horizontal {
    background-color: transparent;
    height: 10px;
    margin: 0 4px 2px 4px;
    border: none;
}

QTableView QScrollBar::handle:horizontal {
    background-color: #d0d0d0;
    border-radius: 4px;
    min-width: 30px;
}

QTableView QScrollBar::handle:horizontal:hover {
    background-color: #b3b3b3;
}

QTableView QScrollBar::add-line:horizontal,
QTableView QScrollBar::sub-line:horizontal {
    width: 0;
    background: none;
    border: none;
}

QLabel#infoBanner {
    background-color: #e8f0fb;
    color: #1a5fb4;
    border: 1px solid #bcd4f0;
    border-radius: 6px;
    padding: 8px 12px;
    font-size: 12px;
}

/*  CALENDAR POPUP STYLING --- */
/* --- Calendar container --- */
QCalendarWidget {
    background-color: #ffffff;
    border: 1px solid #d9d9d9;
    border-radius: 8px;
}

/* --- Navigation bar (month/year header) --- */
QCalendarWidget QWidget#qt_calendar_navigationbar {
    background-color: #f7f7f7;
    border-bottom: 1px solid #d9d9d9;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    padding: 4px 8px;
}

/* --- Month/Year label --- */
QCalendarWidget QToolButton {
    color: #1e1e1e;
    font-size: 13px;
    font-weight: 500;
    background-color: transparent;
    border: none;
    border-radius: 4px;
    padding: 4px 8px;
    margin: 2px;
}

QCalendarWidget QToolButton:hover {
    background-color: #e8e8e8;
}

QCalendarWidget QToolButton:pressed {
    background-color: #d9d9d9;
}

/* --- Prev/Next month arrows --- */
QCalendarWidget QToolButton#qt_calendar_prevmonth {
    qproperty-icon: none;
    qproperty-text: "◀";
    font-size: 10px;
    padding: 4px 8px;
}

QCalendarWidget QToolButton#qt_calendar_nextmonth {
    qproperty-icon: none;
    qproperty-text: "▶";
    font-size: 10px;
    padding: 4px 8px;
}

/* --- Month dropdown (QMenu) --- */
QCalendarWidget QMenu {
    background-color: #ffffff;
    color: #1e1e1e;
    border: 1px solid #d9d9d9;
    border-radius: 6px;
    padding: 4px;
}

QCalendarWidget QMenu::item {
    padding: 6px 16px;
    border-radius: 4px;
}

QCalendarWidget QMenu::item:selected {
    background-color: #2a82da;
    color: #ffffff;
}

/* --- Year spinbox --- */
QCalendarWidget QSpinBox {
    color: #1e1e1e;
    background-color: #ffffff;
    border: 1px solid #d9d9d9;
    border-radius: 4px;
    padding: 2px 6px;
    font-size: 13px;
    selection-background-color: #2a82da;
    selection-color: #ffffff;
}

QCalendarWidget QSpinBox::up-button,
QCalendarWidget QSpinBox::down-button {
    subcontrol-origin: border;
    width: 18px;
    background-color: #e8e8e8;
    border: none;
}

QCalendarWidget QSpinBox::up-button {
    border-top-right-radius: 4px;
    subcontrol-position: top right;
}

QCalendarWidget QSpinBox::down-button {
    border-bottom-right-radius: 4px;
    subcontrol-position: bottom right;
}

QCalendarWidget QSpinBox::up-button:hover,
QCalendarWidget QSpinBox::down-button:hover {
    background-color: #d9d9d9;
}

QCalendarWidget QSpinBox::up-arrow {
    image: url(svg:up_arrow.svg);
    width: 8px;
    height: 8px;
}

QCalendarWidget QSpinBox::down-arrow {
    image: url(svg:down_arrow.svg);
    width: 8px;
    height: 8px;
}

/* --- Day header (Mon, Tue, Wed...) --- */
QCalendarWidget QWidget {
    alternate-background-color: transparent;
}

QCalendarWidget QAbstractItemView:enabled {
    background-color: #ffffff;
    color: #1e1e1e;
    font-size: 13px;
    selection-background-color: #2a82da;
    selection-color: #ffffff;
    outline: 0;
    border: none;
}

/* --- Day cells --- */
QCalendarWidget QAbstractItemView::item {
    padding: 6px;
    margin: 1px;
    border-radius: 4px;
}

QCalendarWidget QAbstractItemView::item:hover {
    background-color: #f0f0f0;
}

QCalendarWidget QAbstractItemView::item:selected {
    background-color: #2a82da;
    color: #ffffff;
    border-radius: 4px;
}

/* --- Today highlight --- */
QCalendarWidget QAbstractItemView::item:focus {
    background-color: #e8f0fb;
    border: 1px solid #2a82da;
    border-radius: 4px;
}

/* --- Days from other months (grayed) --- */
QCalendarWidget QAbstractItemView:disabled {
    color: #b3b3b3;
}

/* --- Weekday header row --- */
QCalendarWidget QWidget#qt_calendar_calendarview {
    background-color: #ffffff;
    border-bottom-left-radius: 8px;
    border-bottom-right-radius: 8px;
}


/* light.qss — Wallet Card Styling */
/* === WALLET CARDS === */

QFrame#walletCard {
    border-radius: 12px;
    padding: 5px;
}

/* Force all children transparent */
QFrame#walletCard QWidget {
    background: transparent;
}

/* Active card */
QFrame#walletCard[active="true"] {
    background: qlineargradient(
        x1: 0, y1: 0, x2: 1, y2: 1,
        stop: 0 #1a5fb4,
        stop: 1 #2a82da
    );
    border: none;
}

/* Inactive card */
QFrame#walletCard[active="false"] {
    background-color: #ffffff;
    border: 1px solid #d9d9d9;
}

/* --- Text colors --- */
QFrame#walletCard[active="true"] QLabel {
    color: #ffffff;
}

QFrame#walletCard[active="false"] QLabel {
    color: #1e1e1e;
}

QFrame#walletCard[active="true"] QLabel#walletCardMuted,
QFrame#walletCard[active="true"] QLabel#walletCardCurrency {
    color: rgba(255, 255, 255, 0.6);
}

QFrame#walletCard[active="false"] QLabel#walletCardMuted,
QFrame#walletCard[active="false"] QLabel#walletCardCurrency {
    color: #999999;
}

QLabel#walletCardName {
    font-size: 20px;
    font-weight: 600;
}

QLabel#walletCardBalance {
    font-size: 22px;
    font-weight: 500;
}

QFrame#walletCard[active="true"] QLabel#walletActiveBadge {
    background-color: rgba(255, 255, 255, 0.25);
    color: white;
    padding: 2px 10px;
    border-radius: 8px;
    font-size: 11px;
}

/* ==========================================
   DUE TRANSACTIONS DIALOG - LIGHT THEME
   Append to light.qss
   ========================================== */

/* --- Dialog header --- */
QLabel#dueDialogTitle {
    font-size: 16px;
    font-weight: 600;
    color: #1e1e1e;
}

QLabel#dueDialogSubtitle {
    font-size: 12px;
    color: #5a5a5a;
}

/* --- Group card --- */
QFrame#dueTransactionRow {
    background-color: #ffffff;
    border: 2px solid #d9d9d9;
    border-radius: 8px;
}

/*
QFrame#dueTransactionRow QWidget {
    background: transparent;
}

*/
QLabel#dueRowTitle {
    font-size: 14px;
    font-weight: 600;
    color: #1e1e1e;
}

QLabel#dueRowInterval {
    font-size: 12px;
    color: #5a5a5a;
    background-color: #d9d9d9;
    border: 1px solid #808080;
    border-radius: 10px;
    padding: 0px 10px;
}

QLabel#dueRowCount {
    font-size: 11px;
    color: #808080;
}

QLabel#dueRowSummary {
    font-size: 11px;
    color: #808080;
}

/* --- Amount, colored via setProperty("operation", ...) --- */
QLabel#dueRowAmount {
    font-size: 13px;
    font-weight: 600;
}

QLabel#dueRowAmount[operation="income"] {
    color: #008000;
}

QLabel#dueRowAmount[operation="expense"] {
    color: #ff3333;
}

QLabel#dueRowAmount[operation="saving"] {
    color: #1e65c8;
}

QLabel#dueRowAmount[operation="investment"] {
    color: #ba7517;
}

/* --- Occurrence rows --- */
QLabel#occurrenceDate {
    font-size: 13px;
    color: #1e1e1e;
}

QLabel#occurrenceTimeline {
    font-size: 11px;
    color: #808080;
}

QLabel#occurrenceTimeline[overdue="true"] {
    color: #ff3333;
}

/* --- Skip button (replaces inline bg_color) --- */
QPushButton#dueSkipButton {
    background-color: #fdeaea;
    color: #c53030;
    border: 1px solid #f5c6c6;
    border-radius: 8px;
    padding: 6px 12px;
}

QPushButton#dueSkipButton:hover {
    background-color: #fad4d4;
}

QPushButton#dueSkipButton:pressed {
    background-color: #f5b3b3;
    color: #8b1a1a;
}

/* --- Scroll area inside a group card --- */
QFrame#dueTransactionRow QScrollBar:vertical {
    background-color: transparent;
    width: 8px;
    margin: 0;
    border: none;
}

QFrame#dueTransactionRow QScrollBar::handle:vertical {
    background-color: #d0d0d0;
    border-radius: 4px;
    min-height: 24px;
}

QFrame#dueTransactionRow QScrollBar::handle:vertical:hover {
    background-color: #b3b3b3;
}

QFrame#dueTransactionRow QScrollBar::add-line:vertical,
QFrame#dueTransactionRow QScrollBar::sub-line:vertical {
    height: 0;
    background: none;
    border: none;
}




/* ==========================================
   PUSH BUTTON VARIANTS - LIGHT THEME
   Append to light.qss

   Use with PushButton(object_name="primaryButton") etc.
   Themed buttons skip their inline stylesheet, so these rules apply.
   ========================================== */

/* --- Primary: solid accent fill --- */
QPushButton#primaryButton {
    background-color: #4dacff;
    color: #ffffff;
    border: 2px solid #4dacff;
    border-radius: 10px;
    font-size: 10pt;
    font-weight: bold;
    padding: 0px;
}

QPushButton#primaryButton:hover {
    background-color: #2b9bff;
    border-color: #2b9bff;
}

QPushButton#primaryButton:pressed {
    background-color: #0085fc;
    border-color: #0085fc;
    color: #ffffff;
}

QPushButton#primaryButton:disabled {
    background-color: #d9d9d9;
    border-color: #d9d9d9;
    color: #8c8c8c;
}

/* --- Secondary: outlined, fills on press (the old alternate_look) --- */
QPushButton#secondaryButton {
    background-color: #ffffff;
    color: #4dacff;
    border: 2px solid #4dacff;
    border-radius: 10px;
    font-size: 10pt;
    font-weight: bold;
    padding: 0px;
}

QPushButton#secondaryButton:hover {
    background-color: #eef7ff;
}

QPushButton#secondaryButton:pressed {
    background-color: #0085fc;
    border-color: #0085fc;
    color: #ffffff;
}

QPushButton#secondaryButton:disabled {
    background-color: #ffffff;
    border-color: #d9d9d9;
    color: #b3b3b3;
}

/* --- Neutral: quiet grey, for low-emphasis actions --- */
QPushButton#neutralButton {
    background-color: #f5f5f5;
    color: #333333;
    border: 1px solid #d9d9d9;
    border-radius: 10px;
    font-size: 10pt;
    font-weight: bold;
    padding: 0px;
}

QPushButton#neutralButton:hover {
    background-color: #e8e8e8;
}

QPushButton#neutralButton:pressed {
    background-color: #d9d9d9;
    color: #1e1e1e;
}

QPushButton#neutralButton:disabled {
    background-color: #f5f5f5;
    border-color: #ededed;
    color: #b3b3b3;
}

/* --- Danger: destructive actions --- */
QPushButton#dangerButton {
    background-color: #fdeaea;
    color: #c53030;
    border: 1px solid #f5c6c6;
    border-radius: 10px;
    font-size: 10pt;
    font-weight: bold;
    padding: 0px;
}

QPushButton#dangerButton:hover {
    background-color: #fad4d4;
}

QPushButton#dangerButton:pressed {
    background-color: #f5b3b3;
    color: #8b1a1a;
}

QPushButton#dangerButton:disabled {
    background-color: #f5f5f5;
    border-color: #ededed;
    color: #b3b3b3;
}

/* --- Small size modifier: pair via setProperty("size", "small") --- */
QPushButton[size="small"] {
    font-size: 8pt;
    border-radius: 8px;
}
